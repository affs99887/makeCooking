/**splashScreen.wxss**/

/* 容器 - 全屏沉浸式覆盖层 */
.splash-container {
    width: 100vw;
    height: 100vh;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(165deg, #f9f7f4 0%, #f0ebe5 50%, #e8e1d8 100%);
    will-change: opacity, transform;
}

/* 背景渐变层 - 柔和呼吸效果 */
.gradient-backdrop {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(
            circle at center,
            rgba(235, 231, 224, 0.8) 0%,
            rgba(247, 245, 242, 0.4) 40%,
            transparent 70%
    );
    animation: breathe 4s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
}

@keyframes breathe {
    0%, 100% {
        transform: scale(1) rotate(0deg);
        opacity: 0.6;
    }
    50% {
        transform: scale(1.1) rotate(5deg);
        opacity: 0.8;
    }
}

/* 香料粒子 - 从四周飘入 */
.essence-particle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 80rpx;
    height: 80rpx;
    margin-left: -40rpx;
    margin-top: -40rpx;
    border-radius: 50%;
    background: radial-gradient(
            circle at 30% 30%,
            rgba(195, 176, 145, 0.4),
            rgba(163, 154, 143, 0.2)
    );
    backdrop-filter: blur(10rpx);
    box-shadow: 0 8rpx 32rpx rgba(163, 154, 143, 0.15),
    inset 0 2rpx 8rpx rgba(255, 255, 255, 0.4);
    opacity: 0;
}

.particle-1 {
    width: 100rpx;
    height: 100rpx;
    margin-left: -50rpx;
    margin-top: -50rpx;
    animation: drift-in-1 1.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s forwards;
}

.particle-2 {
    width: 60rpx;
    height: 60rpx;
    margin-left: -30rpx;
    margin-top: -30rpx;
    animation: drift-in-2 1.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.4s forwards;
}

.particle-3 {
    width: 120rpx;
    height: 120rpx;
    margin-left: -60rpx;
    margin-top: -60rpx;
    animation: drift-in-3 2s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s forwards;
}

.particle-4 {
    width: 70rpx;
    height: 70rpx;
    margin-left: -35rpx;
    margin-top: -35rpx;
    animation: drift-in-4 1.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s forwards;
}

.particle-5 {
    width: 90rpx;
    height: 90rpx;
    margin-left: -45rpx;
    margin-top: -45rpx;
    animation: drift-in-5 1.9s cubic-bezier(0.34, 1.56, 0.64, 1) 0.35s forwards;
}

/* 粒子飘入动画 - 每个粒子从不同方向飘入 */
@keyframes drift-in-1 {
    from {
        transform: translate(-400rpx, -300rpx) scale(0.3) rotate(-180deg);
        opacity: 0;
    }
    to {
        transform: translate(180rpx, -220rpx) scale(1) rotate(0deg);
        opacity: 0.6;
    }
}

@keyframes drift-in-2 {
    from {
        transform: translate(400rpx, -200rpx) scale(0.3) rotate(180deg);
        opacity: 0;
    }
    to {
        transform: translate(200rpx, 180rpx) scale(1) rotate(0deg);
        opacity: 0.5;
    }
}

@keyframes drift-in-3 {
    from {
        transform: translate(-450rpx, 250rpx) scale(0.3) rotate(-150deg);
        opacity: 0;
    }
    to {
        transform: translate(-220rpx, 160rpx) scale(1) rotate(0deg);
        opacity: 0.7;
    }
}

@keyframes drift-in-4 {
    from {
        transform: translate(380rpx, 280rpx) scale(0.3) rotate(150deg);
        opacity: 0;
    }
    to {
        transform: translate(-200rpx, -180rpx) scale(1) rotate(0deg);
        opacity: 0.55;
    }
}

@keyframes drift-in-5 {
    from {
        transform: translate(0rpx, -500rpx) scale(0.3) rotate(90deg);
        opacity: 0;
    }
    to {
        transform: translate(0rpx, 240rpx) scale(1) rotate(0deg);
        opacity: 0.65;
    }
}

/* 品牌核心区域 */
.brand-core {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* 中心光晕 */
.core-glow {
    position: absolute;
    width: 400rpx;
    height: 400rpx;
    border-radius: 50%;
    background: radial-gradient(
            circle,
            rgba(195, 176, 145, 0.25) 0%,
            rgba(195, 176, 145, 0.1) 40%,
            transparent 70%
    );
    filter: blur(40rpx);
    animation: glow-pulse 3s ease-in-out infinite;
    opacity: 0;
    animation-delay: 0.8s;
}

@keyframes glow-pulse {
    0%, 100% {
        transform: scale(0.9);
        opacity: 0.4;
    }
    50% {
        transform: scale(1.1);
        opacity: 0.7;
    }
}

/* 品牌名称容器 */
.brand-name {
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    animation: brand-reveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.8s forwards;
}

@keyframes brand-reveal {
    from {
        opacity: 0;
        transform: translateY(30rpx) scale(0.9);
        filter: blur(10rpx);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
    }
}

/* 主品牌文字 - 优雅的衬线字体 */
.brand-text-main {
    font-family: 'Georgia', 'Palatino Linotype', 'Times New Roman', serif;
    font-size: 64rpx;
    font-weight: 500;
    letter-spacing: 2rpx;
    color: #3d3731;
    margin-bottom: 16rpx;
    text-shadow: 0 2rpx 8rpx rgba(61, 55, 49, 0.1),
    0 4rpx 16rpx rgba(61, 55, 49, 0.05);
}

/* 副标题 - 精致细腻 */
.brand-text-sub {
    font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', sans-serif;
    font-size: 26rpx;
    font-weight: 300;
    letter-spacing: 6rpx;
    color: #8b8279;
    opacity: 0;
    animation: subtitle-fade 1s cubic-bezier(0.16, 1, 0.3, 1) 1.4s forwards;
}

@keyframes subtitle-fade {
    from {
        opacity: 0;
        transform: translateY(10rpx);
    }
    to {
        opacity: 0.85;
        transform: translateY(0);
    }
}

/* 装饰性环绕圆环 */
.orbit-ring {
    position: absolute;
    border-radius: 50%;
    border: 1rpx solid rgba(163, 154, 143, 0.15);
    opacity: 0;
}

.ring-1 {
    width: 500rpx;
    height: 500rpx;
    animation: ring-expand 2s cubic-bezier(0.16, 1, 0.3, 1) 1s forwards;
}

.ring-2 {
    width: 600rpx;
    height: 600rpx;
    animation: ring-expand 2s cubic-bezier(0.16, 1, 0.3, 1) 1.2s forwards;
}

@keyframes ring-expand {
    from {
        transform: scale(0.3);
        opacity: 0;
    }
    to {
        transform: scale(1);
        opacity: 0.4;
    }
}

/* 底部加载提示 */
.loading-hint {
    position: absolute;
    bottom: 120rpx;
    display: flex;
    gap: 16rpx;
    opacity: 0;
    animation: hint-fade-in 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1.5s forwards;
}

@keyframes hint-fade-in {
    from {
        opacity: 0;
        transform: translateY(20rpx);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* 脉动点 */
.dot {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    background: #a39a8f;
    animation: dot-pulse 1.4s ease-in-out infinite;
}

.dot-1 {
    animation-delay: 0s;
}

.dot-2 {
    animation-delay: 0.2s;
}

.dot-3 {
    animation-delay: 0.4s;
}

@keyframes dot-pulse {
    0%, 100% {
        transform: scale(0.8);
        opacity: 0.4;
    }
    50% {
        transform: scale(1.2);
        opacity: 1;
    }
}

/* 页面淡出动画（组件卸载前触发） */
.splash-container.fade-out {
    animation: page-fade-out 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes page-fade-out {
    to {
        opacity: 0;
        transform: scale(0.98);
        filter: blur(10rpx);
    }
}
