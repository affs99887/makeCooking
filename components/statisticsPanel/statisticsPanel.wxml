<view class="statistics-panel theme-{{theme}}" style="padding-top: {{contentTop}}px;">
  <view class="statistics-heading">
    <view>
      <text class="statistics-kicker">记录概览</text>
      <text class="statistics-title">统计</text>
    </view>
    <text class="statistics-updated" wx:if="{{updatedTime && status === 'loaded'}}">更新于 {{updatedTime}}</text>
  </view>

  <view class="range-control" role="tablist" aria-label="统计时段">
    <view class="range-option {{range === item.key ? 'is-active' : ''}}"
          wx:for="{{ranges}}" wx:key="key"
          role="tab" aria-selected="{{range === item.key}}"
          data-range="{{item.key}}" bindtap="onRangeChange">{{item.label}}</view>
    <view class="range-indicator" style="transform: translateX({{indicatorPosition * 128}}rpx);"></view>
  </view>

  <swiper class="statistics-swiper" current="{{rangeIndex}}" duration="380" easing-function="easeOutCubic"
          bindtouchstart="onRangeTouchStart" bindchange="onRangeSwipe"
          bindtransition="onRangeTransition" bindanimationfinish="onRangeAnimationEnd">
    <swiper-item class="statistics-pane {{range === panel.key ? 'is-active' : ''}}" wx:for="{{panels}}" wx:key="key" wx:for-item="panel">
      <scroll-view class="statistics-scroll" scroll-y enhanced show-scrollbar="{{false}}"
                   refresher-enabled refresher-triggered="{{refreshing}}"
                   bindrefresherrefresh="onRefresh">
        <view class="statistics-body">
          <view class="statistics-state" wx:if="{{status === 'loading'}}">
            <view class="loading-rule"></view>
            <text class="state-title">正在汇总记录</text>
            <text class="state-description">让每一次记录都被看见</text>
          </view>
          <view class="statistics-state" wx:elif="{{status === 'error'}}">
            <text class="state-title">暂时无法读取统计</text>
            <text class="state-description">请检查网络，再试一次</text>
            <button class="statistics-button" bindtap="onRetry">重新加载</button>
          </view>
          <block wx:else>
            <view class="summary-hero">
              <view class="summary-eyebrow">
                <text>记录数</text>
                <text class="summary-period">{{panel.summary.rangeLabel}}</text>
              </view>
              <view class="summary-number-row">
                <text class="summary-number">{{panel.summary.recordCountText}}</text>
                <text class="summary-number-unit">条</text>
              </view>
              <text class="summary-footnote">在 {{panel.summary.activeDays}} 个日子里留下记录</text>
            </view>

            <view class="summary-metrics">
              <view class="summary-metric">
                <text class="metric-label">累计次数</text>
                <text class="metric-number">{{panel.summary.activityCountText}}</text>
                <text class="metric-unit">次</text>
              </view>
              <view class="summary-metric">
                <text class="metric-label">平均评分</text>
                <text class="metric-number">{{panel.summary.averageScoreText}}</text>
                <text class="metric-unit">分</text>
              </view>
              <view class="summary-metric">
                <text class="metric-label">最高评分</text>
                <text class="metric-number">{{panel.summary.bestScoreText}}</text>
                <text class="metric-unit">分</text>
              </view>
            </view>

            <view class="insight-section" wx:if="{{panel.key === 'month' || panel.summary.recordCount > 0}}">
              <view class="insight-header">
                <text class="insight-title">{{panel.summary.trendTitle}}</text>
                <text class="insight-caption">{{panel.summary.trendCaption}}</text>
              </view>
              <view class="record-calendar" wx:if="{{panel.key === 'month'}}">
                <view class="calendar-weekdays">
                  <text class="calendar-weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
                </view>
                <view class="calendar-grid">
                  <view class="calendar-slot" wx:for="{{panel.summary.calendar}}" wx:key="key" wx:for-item="day">
                    <view wx:if="{{!day.isEmpty}}"
                          class="calendar-day {{day.count > 0 ? 'has-records' : ''}} {{day.isToday ? 'is-today' : ''}} {{day.isFuture ? 'is-future' : ''}} {{panel.selectedBucketKey === day.key ? 'is-selected' : ''}}"
                          data-range="{{panel.key}}" data-index="{{day.trendIndex}}" bindtap="onBucketTap" role="button"
                          aria-label="{{day.dateLabel}}{{day.isToday ? '，今天' : ''}}，{{day.count}}条记录"
                          aria-pressed="{{panel.selectedBucketKey === day.key}}">
                      <text class="calendar-date">{{day.label}}</text>
                      <text class="calendar-count">{{day.count > 0 ? day.count + ' 条' : ''}}</text>
                    </view>
                  </view>
                </view>
              </view>
              <view class="trend-plot" wx:else>
                <view class="trend-axis">
                  <text>{{panel.summary.trendMax}}</text>
                  <text>{{panel.summary.trendMiddle}}</text>
                  <text>0</text>
                </view>
                <view class="trend-content">
                  <view class="trend-columns">
                    <view class="trend-column {{panel.selectedBucketKey === bucket.key ? 'is-selected' : ''}}"
                          wx:for="{{panel.summary.trend}}" wx:key="key" wx:for-item="bucket"
                          data-range="{{panel.key}}" data-index="{{index}}" bindtap="onBucketTap"
                          aria-label="{{bucket.dateLabel}}，{{bucket.count}}条记录">
                      <view class="trend-bar-track">
                        <view class="trend-bar {{bucket.count === 0 ? 'is-zero' : ''}}" style="height: {{bucket.height}}%;"></view>
                      </view>
                      <text class="trend-label">{{bucket.label}}</text>
                    </view>
                  </view>
                </view>
              </view>
              <view class="trend-detail" wx:if="{{panel.selectedBucket}}">
                <text>{{panel.selectedBucket.dateLabel}}</text>
                <text class="trend-detail-value">{{panel.selectedBucket.count}} 条 · 均分 {{panel.selectedBucket.averageScoreText}}</text>
              </view>
              <view class="calendar-legend" wx:if="{{panel.key === 'month'}}">
                <view class="calendar-legend-item"><view class="calendar-legend-record"></view><text>有记录</text></view>
                <view class="calendar-legend-item"><view class="calendar-legend-today"></view><text>今天</text></view>
                <text class="calendar-tip">轻触日期查看详情</text>
              </view>
              <text class="chart-hint" wx:else>轻触柱形查看详情</text>
            </view>

            <view class="statistics-empty" wx:if="{{panel.summary.recordCount === 0}}">
              <text class="state-title">这个时段还没有记录</text>
              <text class="state-description">记下今天，慢慢积累自己的轨迹</text>
              <button class="statistics-button" bindtap="onCreate">记录今日</button>
            </view>

            <view class="insight-section" wx:if="{{panel.summary.breakdown.length}}">
              <view class="insight-header">
                <text class="insight-title">项目分布</text>
                <text class="insight-caption">按累计次数</text>
              </view>
              <view class="distribution-row" wx:for="{{panel.summary.breakdown}}" wx:key="key">
                <view class="distribution-heading">
                  <text class="distribution-name">{{item.label}}</text>
                  <view><text class="distribution-count">{{item.countText}} 次</text><text class="distribution-percent">{{item.percent}}%</text></view>
                </view>
                <view class="distribution-track"><view class="distribution-fill" style="width: {{item.width}}%;"></view></view>
              </view>
            </view>

            <view class="insight-section" wx:if="{{panel.summary.methodBreakdown.length}}">
              <view class="insight-header"><text class="insight-title">常用手法</text><text class="insight-caption">出现频率</text></view>
              <view class="method-row" wx:for="{{panel.summary.methodBreakdown}}" wx:key="label">
                <text class="method-rank">0{{index + 1}}</text>
                <text class="method-name">{{item.label}}</text>
                <text class="method-count">{{item.count}} 条</text>
              </view>
            </view>
            <view class="statistics-footer">
              <text>次数按各项目的叠加数量累计</text>
              <text>评分按每条记录计算 · {{panel.summary.scoredCount}} 条有评分</text>
            </view>
          </block>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>
</view>
