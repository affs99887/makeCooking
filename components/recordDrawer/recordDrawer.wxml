<!-- components/recordDrawer/recordDrawer.wxml -->

<!-- 遮罩层 -->
<view class="drawer-mask {{visible ? 'show' : ''}}"
      style="--mask-blur: {{maskBlur}}rpx;"
      bindtap="onMaskTap"
      wx:if="{{isAnimating}}">

  <!-- 抽屉容器 -->
  <view class="drawer-container {{isOpen ? 'is-open' : ''}} {{isDragging ? 'is-dragging' : ''}} {{isExpanded ? 'is-expanded' : ''}} {{isReadonly ? 'is-readonly' : ''}}"
        style="transform: translate3d(0, {{drawerTranslate}}px, 0);"
        catchtap="onDrawerTap">
    <!-- 柔和光晕背景 -->
    <view class="drawer-ambient">
      <view class="ambient-orb orb-left"></view>
      <view class="ambient-orb orb-right"></view>
      <view class="ambient-sheen"></view>
    </view>

    <!-- 顶部拖动条装饰 -->
    <view class="drawer-handle"
          bindtouchstart="onHandleTouchStart"
          catchtouchmove="onHandleTouchMove"
          bindtouchend="onHandleTouchEnd"
          bindtouchcancel="onHandleTouchEnd">
      <view class="handle-pill"></view>
    </view>

    <!-- 标题区域 -->
    <view class="drawer-header">
      <view class="header-orb header-orb-left"></view>
      <view class="header-orb header-orb-right"></view>
      <text class="drawer-title">{{drawerTitle}}</text>
      <text class="drawer-subtitle">{{drawerSubtitle}}</text>
      <view class="header-divider"></view>
    </view>

    <!-- 滚动内容区 -->
    <scroll-view class="drawer-content" scroll-y>

      <!-- 烹饪风格选择 -->
      <view class="section-block type-section {{isClosing ? 'section-exit' : ''}}">
        <view class="section-header type-header">
          <view class="section-icon"></view>
          <text class="section-title">烹饪风格</text>
          <text class="section-hint">可叠加</text>
        </view>

        <view class="type-deck">
          <view class="type-grid">
            <view class="type-card type-card-standard {{typeCounts.standard > 0 ? 'active' : ''}}"
                bindtap="onTypeToggle"
                catchlongpress="onTypeDecrease"
                data-type="standard">
              <view class="type-check"></view>
              <view class="type-card-content">
                <text class="type-name-cn">标准</text>
                <text class="type-name-en">Standard</text>
              </view>
              <view class="type-count" wx:if="{{typeCounts.standard > 1}}"
                    catchtap="onTypeDecrease"
                    data-type="standard">
                <text class="type-count-text">x{{typeCounts.standard}}</text>
              </view>
            </view>

            <view class="type-card type-card-service {{typeCounts.service > 0 ? 'active' : ''}}"
                bindtap="onTypeToggle"
                catchlongpress="onTypeDecrease"
                data-type="service">
              <view class="type-check"></view>
              <view class="type-card-content">
                <text class="type-name-cn">服务</text>
                <text class="type-name-en">Service</text>
              </view>
              <view class="type-count" wx:if="{{typeCounts.service > 1}}"
                    catchtap="onTypeDecrease"
                    data-type="service">
                <text class="type-count-text">x{{typeCounts.service}}</text>
              </view>
            </view>

            <view class="type-card type-card-backin {{typeCounts.backin > 0 ? 'active' : ''}}"
                bindtap="onTypeToggle"
                catchlongpress="onTypeDecrease"
                data-type="backin">
              <view class="type-check"></view>
              <view class="type-card-content">
                <text class="type-name-cn">回味</text>
                <text class="type-name-en">Backin</text>
              </view>
              <view class="type-count" wx:if="{{typeCounts.backin > 1}}"
                    catchtap="onTypeDecrease"
                    data-type="backin">
                <text class="type-count-text">x{{typeCounts.backin}}</text>
              </view>
            </view>

            <view class="type-card type-card-lite {{typeCounts.lite > 0 ? 'active' : ''}}"
                bindtap="onTypeToggle"
                catchlongpress="onTypeDecrease"
                data-type="lite">
              <view class="type-check"></view>
              <view class="type-card-content">
                <text class="type-name-cn">清淡</text>
                <text class="type-name-en">Lite</text>
              </view>
              <view class="type-count" wx:if="{{typeCounts.lite > 1}}"
                    catchtap="onTypeDecrease"
                    data-type="lite">
                <text class="type-count-text">x{{typeCounts.lite}}</text>
              </view>
            </view>

            <view class="type-card type-card-reverse {{typeCounts.reverse > 0 ? 'active' : ''}}"
                bindtap="onTypeToggle"
                catchlongpress="onTypeDecrease"
                data-type="reverse">
              <view class="type-check"></view>
              <view class="type-card-content">
                <text class="type-name-cn">反转</text>
                <text class="type-name-en">Reverse</text>
              </view>
              <view class="type-count" wx:if="{{typeCounts.reverse > 1}}"
                    catchtap="onTypeDecrease"
                    data-type="reverse">
                <text class="type-count-text">x{{typeCounts.reverse}}</text>
              </view>
            </view>

            <view class="type-card type-card-suck {{typeCounts.suck > 0 ? 'active' : ''}}"
                  bindtap="onTypeToggle"
                  catchlongpress="onTypeDecrease"
                  data-type="suck">
              <view class="type-check"></view>
              <view class="type-card-content">
                <text class="type-name-cn">萨克</text>
                <text class="type-name-en">Suck</text>
              </view>
              <view class="type-count" wx:if="{{typeCounts.suck > 1}}"
                    catchtap="onTypeDecrease"
                    data-type="suck">
                <text class="type-count-text">x{{typeCounts.suck}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>



      <!-- 烹饪手法选择（仅在选择Service时显示） -->
      <view class="section-block method-section {{methodExiting || isClosing ? 'section-exit' : ''}}"
            wx:if="{{renderMethodSection}}">
        <view class="section-header">
          <view class="section-icon"></view>
          <text class="section-title">烹饪手法</text>
          <text class="section-hint">单选</text>
        </view>

        <view class="method-list">
          <view class="method-item {{selectedMethod === 'Lollipop' ? 'active' : ''}}"
                bindtap="onMethodSelect"
                data-method="Lollipop">
            <view class="method-check"></view>
            <view class="method-info">
              <text class="method-label-cn">棒棒糖法</text>
              <text class="method-label-en">Lollipop</text>
            </view>
          </view>

          <view class="method-item {{selectedMethod === 'Seafood' ? 'active' : ''}}"
                bindtap="onMethodSelect"
                data-method="Seafood">
            <view class="method-check"></view>
            <view class="method-info">
              <text class="method-label-cn">海鲜法</text>
              <text class="method-label-en">Seafood</text>
            </view>
          </view>

          <view class="method-item {{selectedMethod === 'Both' ? 'active' : ''}}"
                bindtap="onMethodSelect"
                data-method="Both">
            <view class="method-check"></view>
            <view class="method-info">
              <text class="method-label-cn">双拼法</text>
              <text class="method-label-en">Both</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 评分系统 -->
      <view class="section-block" wx:if="{{showScoreSection}}">
        <view class="section-header score-header">
          <view class="section-icon"></view>
          <text class="section-title">满意度评分</text>
          <view class="score-header-actions">
            <text class="section-hint">{{scoreMode === 'total' ? '总分' : '分开打分'}}</text>
            <button class="score-toggle"
                    wx:if="{{!isReadonly && showScoreToggle}}"
                    bindtap="onScoreModeToggle"
                    hover-class="score-toggle-hover">
              {{scoreMode === 'total' ? '分开打分' : '只打总分'}}
            </button>
          </view>
        </view>

        <view class="score-total-card" wx:if="{{scoreMode === 'perType'}}">
          <text class="score-total-label">总分</text>
          <view class="score-total-display">
            <text class="score-total-value">{{totalScore}}</text>
            <text class="score-total-unit">分</text>
          </view>
        </view>

        <view class="score-type-list" wx:if="{{scoreMode === 'perType'}}">
          <block wx:for="{{scoreTypeList}}" wx:key="key">
            <view class="score-type-item">
              <view class="score-type-header">
                <text class="score-type-name">{{item.label}}</text>
                <text class="score-type-count" wx:if="{{item.count > 1}}">x{{item.count}}</text>
                <view class="score-type-score">
                  <text class="score-type-number">{{item.score}}</text>
                  <text class="score-type-max">/ {{typeScoreMax}}</text>
                </view>
              </view>

              <view class="slider-container score-type-slider">
                <view class="slider-rail"></view>
                <view class="slider-fill" style="width: calc((100% - 32rpx) * {{item.score / typeScoreMax}});"></view>
                <view class="slider-glow" style="width: calc((100% - 32rpx) * {{item.score / typeScoreMax}});"></view>
                <slider
                  class="score-slider"
                  min="0"
                  max="{{typeScoreMax}}"
                  step="{{scoreStep}}"
                  value="{{item.score}}"
                  disabled="{{isReadonly}}"
                  activeColor="rgba(0, 0, 0, 0)"
                  backgroundColor="rgba(0, 0, 0, 0)"
                  block-color="#ffffff"
                  block-size="32"
                  data-type="{{item.key}}"
                  bindchange="onTypeScoreChange"
                  bindchanging="onTypeScoreChanging"
                />
              </view>

              <view class="score-markers score-type-markers">
                <text class="marker">0</text>
                <text class="marker">1000</text>
                <text class="marker">2000</text>
                <text class="marker">3000</text>
                <text class="marker">4000</text>
              </view>
            </view>
          </block>
        </view>

        <view wx:if="{{scoreMode === 'total'}}">
          <view class="score-display">
            <text class="score-value {{scoreAnimClass}}">{{currentScore}}</text>
            <text class="score-unit">分</text>
            <text class="score-max">/ {{totalScoreMax}}</text>
          </view>

          <view class="slider-container">
            <view class="slider-rail"></view>
            <view class="slider-fill" style="width: calc((100% - 32rpx) * {{currentScore / totalScoreMax}});"></view>
            <view class="slider-glow" style="width: calc((100% - 32rpx) * {{currentScore / totalScoreMax}});"></view>
            <slider
              class="score-slider"
              min="0"
              max="{{totalScoreMax}}"
              step="{{scoreStep}}"
              value="{{currentScore}}"
              disabled="{{isReadonly}}"
              activeColor="rgba(0, 0, 0, 0)"
              backgroundColor="rgba(0, 0, 0, 0)"
              block-color="#ffffff"
              block-size="32"
              bindchange="onScoreChange"
              bindchanging="onScoreChanging"
            />
          </view>

          <view class="score-markers">
            <text class="marker">0</text>
            <text class="marker">1000</text>
            <text class="marker">2000</text>
            <text class="marker">3000</text>
            <text class="marker">{{totalScoreMax}}</text>
          </view>
        </view>
      </view>

      <!-- 时间选择 -->
      <view class="section-block datetime-section">
        <view class="section-header">
          <view class="section-icon"></view>
          <text class="section-title">时间</text>
          <text class="section-hint">年月日时分</text>
        </view>

        <view class="datetime-summary">
          <view class="datetime-text">
            <text class="datetime-main">{{useNowLabel && !showDateEditor ? labelDate : displayDate}}</text>
            <text class="datetime-sub">{{useNowLabel && !showDateEditor ? labelTime : displayTime}}</text>
          </view>
          <button class="datetime-edit-button"
                  wx:if="{{!isReadonly}}"
                  bindtap="onToggleDateEditor"
                  hover-class="datetime-edit-hover">
            {{showDateEditor ? '完成' : '修改时间'}}
          </button>
        </view>

        <view class="datetime-editor {{showDateEditor ? 'show' : ''}}" wx:if="{{showDateEditor}}">
          <view class="datetime-row">
            <picker class="datetime-picker"
                    mode="date"
                    value="{{selectedDate}}"
                    bindchange="onDateChange"
                    disabled="{{isReadonly}}">
              <view class="datetime-card">
                <text class="datetime-label">日期</text>
                <text class="datetime-value">{{displayDate}}</text>
              </view>
            </picker>
            <picker class="datetime-picker"
                    mode="time"
                    value="{{selectedTime}}"
                    bindchange="onTimeChange"
                    disabled="{{isReadonly}}">
              <view class="datetime-card">
                <text class="datetime-label">时间</text>
                <text class="datetime-value">{{displayTime}}</text>
              </view>
            </picker>
          </view>
        </view>
      </view>

      <!-- 底部间距 -->
      <view class="section-spacer"
            style="height: {{spacerHeight}}rpx;"></view>

    </scroll-view>

  </view>

  <!-- 底部操作区 -->
  <view class="drawer-footer {{isOpen ? 'is-open' : ''}}"
        catchtap="onDrawerTap">
    <view class="footer-glow"></view>
    <view class="footer-actions" wx:if="{{currentMode === 'view'}}">
      <button class="action-button edit-button"
              bindtap="onEdit"
              hover-class="action-hover">
        编辑
      </button>
      <button class="action-button delete-button"
              bindtap="onDelete"
              hover-class="action-hover">
        删除记录
      </button>
    </view>
    <button class="save-button {{canSave ? 'enabled' : ''}}"
            wx:if="{{currentMode !== 'view'}}"
            bindtap="onSave"
            disabled="{{!canSave}}"
            hover-class="button-hover">
      <view class="button-shimmer"></view>
      <view class="button-content">
        <text class="button-icon">✦</text>
        <text class="button-text">{{currentMode === 'edit' ? '保存修改' : '保存记录'}}</text>
      </view>
      <view class="button-pulse" wx:if="{{canSave}}"></view>
    </button>
  </view>
</view>
