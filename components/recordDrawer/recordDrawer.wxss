/**recordDrawer.wxss**/

/* ========== 遮罩层 ========== */
.drawer-mask {
  --cream: #faf8f5;
  --lavender: #b8a9d3;
  --lavender-deep: #8b7ba8;
  --rose: #e8c4b8;
  --gold: #d4a574;
  --ink: #2d2a32;
  --ink-soft: #6b5f7a;
  --ink-muted: #9b8fa8;
  --glass: rgba(255, 255, 255, 0.78);
  --glass-strong: rgba(255, 255, 255, 0.92);

  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: radial-gradient(
    120% 90% at 50% 0%,
    rgba(232, 196, 184, 0.25) 0%,
    rgba(184, 169, 211, 0.2) 40%,
    rgba(45, 42, 50, 0.35) 100%
  );
  backdrop-filter: blur(20rpx) saturate(140%);
  z-index: 9998;
  opacity: 0;
  transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.drawer-mask.show {
  opacity: 1;
}

/* ========== 抽屉容器 ========== */
.drawer-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100vw;
  max-width: 100vw;
  height: 100vh;
  max-height: 100vh;
  background: linear-gradient(
    180deg,
    rgba(250, 248, 245, 0.98) 0%,
    rgba(244, 240, 248, 0.96) 100%
  );
  border-radius: 48rpx 48rpx 0 0;
  border: 1rpx solid rgba(184, 169, 211, 0.22);
  box-shadow:
    0 -14rpx 60rpx rgba(139, 123, 168, 0.18),
    0 -4rpx 18rpx rgba(45, 42, 50, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  opacity: 0;
  filter: blur(12rpx);
  transition:
    transform 0.75s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.45s ease,
    filter 0.7s ease,
    border-radius 0.6s ease,
    box-shadow 0.6s ease;
  will-change: transform;
  overflow: hidden;
  backdrop-filter: blur(26rpx) saturate(150%);
  box-sizing: border-box;
  transform-origin: center bottom;
}

.drawer-container.is-open {
  opacity: 1;
  filter: blur(0);
}

.drawer-container.is-dragging {
  transition: none;
}

.drawer-container.is-expanded {
  border-radius: 28rpx 28rpx 0 0;
  box-shadow:
    0 -18rpx 70rpx rgba(139, 123, 168, 0.2),
    0 -6rpx 24rpx rgba(45, 42, 50, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.drawer-ambient {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.ambient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(45rpx);
  opacity: 0.65;
  animation: orb-float 20s ease-in-out infinite;
}

.orb-left {
  width: 320rpx;
  height: 320rpx;
  left: -120rpx;
  top: -160rpx;
  background: radial-gradient(
    circle,
    rgba(184, 169, 211, 0.5) 0%,
    rgba(184, 169, 211, 0.1) 60%,
    transparent 75%
  );
}

.orb-right {
  width: 260rpx;
  height: 260rpx;
  right: -100rpx;
  top: 40rpx;
  background: radial-gradient(
    circle,
    rgba(232, 196, 184, 0.45) 0%,
    rgba(232, 196, 184, 0.12) 60%,
    transparent 75%
  );
  animation-delay: 4s;
}

.ambient-sheen {
  position: absolute;
  top: -50%;
  left: -30%;
  width: 160%;
  height: 80%;
  transform: rotate(-6deg);
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.55) 0%,
    rgba(255, 255, 255, 0) 60%
  );
  opacity: 0.7;
}

@keyframes orb-float {
  0%, 100% {
    transform: translateY(0) translateX(0);
  }
  50% {
    transform: translateY(18rpx) translateX(10rpx);
  }
}

.drawer-handle,
.drawer-header,
.drawer-content {
  position: relative;
  z-index: 1;
}

/* 顶部拖动条 */
.drawer-handle {
  width: 100%;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 18rpx;
}

.handle-pill {
  width: 84rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: linear-gradient(
    90deg,
    rgba(184, 169, 211, 0.3),
    rgba(184, 169, 211, 0.7),
    rgba(232, 196, 184, 0.4)
  );
  box-shadow: 0 4rpx 12rpx rgba(184, 169, 211, 0.25);
}

/* ========== 标题区域 ========== */
.drawer-header {
  position: relative;
  padding: 24rpx 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  animation: header-rise 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.2s forwards;
}

@keyframes header-rise {
  from {
    opacity: 0;
    transform: translateY(-16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.header-orb {
  position: absolute;
  width: 180rpx;
  height: 120rpx;
  border-radius: 50%;
  filter: blur(32rpx);
  opacity: 0.7;
}

.header-orb-left {
  left: 6rpx;
  top: -10rpx;
  background: radial-gradient(
    circle,
    rgba(184, 169, 211, 0.4),
    transparent 70%
  );
}

.header-orb-right {
  right: 0;
  top: -16rpx;
  background: radial-gradient(
    circle,
    rgba(232, 196, 184, 0.35),
    transparent 70%
  );
}

.drawer-title {
  font-family: 'Georgia', 'Times New Roman', serif;
  font-size: 50rpx;
  font-weight: 300;
  letter-spacing: 2rpx;
  color: var(--ink);
  margin-bottom: 10rpx;
  text-shadow: 0 6rpx 24rpx rgba(184, 169, 211, 0.25);
}

.drawer-subtitle {
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans CJK SC', sans-serif;
  font-size: 22rpx;
  font-weight: 300;
  letter-spacing: 3rpx;
  color: var(--ink-muted);
}

.header-divider {
  margin-top: 18rpx;
  width: 120rpx;
  height: 3rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(184, 169, 211, 0.6) 50%,
    transparent 100%
  );
}

/* ========== 滚动内容区 ========== */
.drawer-content {
  flex: 1;
  overflow-y: auto;
  padding: 0 28rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ========== 区块样式 ========== */
.section-block {
  margin-bottom: 28rpx;
  padding: 24rpx;
  background: var(--glass);
  border: 1rpx solid rgba(184, 169, 211, 0.2);
  border-radius: 24rpx;
  box-shadow:
    0 12rpx 32rpx rgba(139, 123, 168, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  opacity: 0;
  animation: section-reveal 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  box-sizing: border-box;
}

.section-block:nth-child(1) {
  animation-delay: 0.25s;
}

.section-block:nth-child(2) {
  animation-delay: 0.35s;
}

.section-block:nth-child(3) {
  animation-delay: 0.45s;
}

@keyframes section-reveal {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 12rpx;
}

.section-icon {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--lavender), var(--rose));
  box-shadow: 0 0 12rpx rgba(184, 169, 211, 0.5);
}

.section-title {
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans CJK SC', sans-serif;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.section-hint {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--ink-muted);
  font-weight: 300;
}

/* ========== 烹饪风格选择（横向滚动） ========== */
.type-scroll {
  width: 100%;
  white-space: nowrap;
  display: flex;
  gap: 12rpx;
  padding: 4rpx 0 6rpx;
}

.type-scroll::-webkit-scrollbar {
  display: none;
}

.type-chip {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-width: 164rpx;
  height: 92rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(184, 169, 211, 0.2);
  border-radius: 18rpx;
  transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  overflow: visible;
  flex-shrink: 0;
}

.type-chip.active {
  background: linear-gradient(
    135deg,
    rgba(184, 169, 211, 0.28) 0%,
    rgba(232, 196, 184, 0.22) 100%
  );
  border-color: rgba(184, 169, 211, 0.55);
  box-shadow:
    0 10rpx 24rpx rgba(184, 169, 211, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  transform: translateY(-2rpx);
}

.chip-decorator {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(184, 169, 211, 0.35);
  transition: all 0.3s ease;
}

.type-chip.active .chip-decorator {
  background: var(--lavender);
  box-shadow: 0 0 14rpx rgba(184, 169, 211, 0.6);
  transform: scale(1.4);
}

.chip-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 0.5rpx;
  line-height: 1.2;
  margin-bottom: 4rpx;
  white-space: nowrap;
}

.chip-subtitle {
  font-size: 18rpx;
  font-weight: 300;
  color: var(--ink-muted);
  letter-spacing: 1rpx;
  text-transform: uppercase;
  white-space: nowrap;
}

.chip-checkmark {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--lavender), var(--rose));
  box-shadow:
    0 4rpx 12rpx rgba(184, 169, 211, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
  animation: checkmark-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.chip-checkmark::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -58%) rotate(45deg);
  width: 8rpx;
  height: 14rpx;
  border-right: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
}

@keyframes checkmark-pop {
  0% {
    transform: scale(0) rotate(-90deg);
    opacity: 0;
  }
  100% {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
}

/* ========== 烹饪手法选择 ========== */
.position-section {
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  margin-bottom: 0;
  transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.position-section.show {
  max-height: 420rpx;
  opacity: 1;
  margin-bottom: 28rpx;
  animation: position-slide-in 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.1s backwards;
}

@keyframes position-slide-in {
  from {
    transform: translateX(-16rpx);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

.position-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.position-item {
  position: relative;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(184, 169, 211, 0.2);
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  overflow: hidden;
}

.position-item.active {
  background: linear-gradient(
    135deg,
    rgba(184, 169, 211, 0.22) 0%,
    rgba(232, 196, 184, 0.18) 100%
  );
  border-color: rgba(184, 169, 211, 0.45);
  box-shadow: 0 8rpx 20rpx rgba(184, 169, 211, 0.18);
}

.position-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(184, 169, 211, 0.4);
  box-shadow: 0 0 8rpx rgba(184, 169, 211, 0.25);
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.position-item.active .position-dot {
  background: var(--lavender);
  box-shadow: 0 0 16rpx rgba(184, 169, 211, 0.55);
  animation: dot-pulse 1.6s ease-in-out infinite;
}

@keyframes dot-pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.3);
    opacity: 0.7;
  }
}

.position-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.position-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 0.5rpx;
  line-height: 1.3;
}

.position-subtitle {
  font-size: 20rpx;
  font-weight: 300;
  color: var(--ink-muted);
  letter-spacing: 1rpx;
}

.position-radio {
  width: 38rpx;
  height: 38rpx;
  border: 2rpx solid rgba(184, 169, 211, 0.35);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.position-item.active .position-radio {
  border-color: var(--lavender);
  box-shadow: 0 0 0 4rpx rgba(184, 169, 211, 0.15);
}

.radio-inner {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--lavender), var(--rose));
  box-shadow: 0 2rpx 6rpx rgba(184, 169, 211, 0.35);
  animation: radio-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes radio-pop {
  0% {
    transform: scale(0);
  }
  100% {
    transform: scale(1);
  }
}

/* ========== 评分系统 ========== */
.score-display {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 32rpx;
  padding: 26rpx;
  background: linear-gradient(
    135deg,
    rgba(184, 169, 211, 0.16) 0%,
    rgba(232, 196, 184, 0.12) 100%
  );
  border-radius: 20rpx;
  border: 1rpx solid rgba(184, 169, 211, 0.2);
}

.score-value {
  font-family: 'Georgia', 'Times New Roman', serif;
  font-size: 80rpx;
  font-weight: 300;
  color: var(--lavender-deep);
  letter-spacing: -2rpx;
  text-shadow:
    0 6rpx 18rpx rgba(184, 169, 211, 0.35),
    0 0 30rpx rgba(184, 169, 211, 0.2);
  animation: score-glow 2.2s ease-in-out infinite;
}

@keyframes score-glow {
  0%, 100% {
    text-shadow:
      0 6rpx 18rpx rgba(184, 169, 211, 0.35),
      0 0 30rpx rgba(184, 169, 211, 0.2);
  }
  50% {
    text-shadow:
      0 6rpx 22rpx rgba(184, 169, 211, 0.5),
      0 0 40rpx rgba(184, 169, 211, 0.35);
  }
}

.score-unit {
  font-size: 30rpx;
  color: var(--ink-soft);
  font-weight: 300;
}

.score-max {
  font-size: 24rpx;
  color: rgba(155, 143, 168, 0.7);
  font-weight: 300;
}

.slider-container {
  position: relative;
  padding: 12rpx 0 4rpx;
  margin-bottom: 8rpx;
}

.score-slider {
  width: 100%;
  position: relative;
  z-index: 2;
}

.slider-track-glow {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  height: 8rpx;
  background: linear-gradient(
    90deg,
    rgba(184, 169, 211, 0.45),
    rgba(232, 196, 184, 0.3)
  );
  border-radius: 4rpx;
  filter: blur(10rpx);
  pointer-events: none;
  transition: width 0.2s ease;
}

.score-markers {
  display: flex;
  justify-content: space-between;
  padding: 0 2rpx;
}

.marker {
  font-size: 18rpx;
  color: rgba(155, 143, 168, 0.6);
  font-weight: 300;
}

/* ========== 底部操作区 ========== */
.section-spacer {
  height: 16rpx;
}

.drawer-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 22rpx 32rpx;
  padding-bottom: calc(22rpx + env(safe-area-inset-bottom));
  background: linear-gradient(
    180deg,
    rgba(250, 248, 245, 0) 0%,
    rgba(250, 248, 245, 0.9) 30%,
    rgba(250, 248, 245, 0.98) 100%
  );
  border-top: 1rpx solid rgba(184, 169, 211, 0.18);
  box-sizing: border-box;
  z-index: 10000;
  opacity: 0;
  transform: translateY(24rpx);
  transition:
    opacity 0.35s ease,
    transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  pointer-events: none;
}

.drawer-footer.is-open {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.footer-glow {
  position: absolute;
  top: -70rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 320rpx;
  height: 90rpx;
  background: radial-gradient(
    ellipse at center,
    rgba(184, 169, 211, 0.18) 0%,
    transparent 70%
  );
  filter: blur(30rpx);
  pointer-events: none;
}

.save-button {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.9) 0%,
    rgba(244, 240, 248, 0.92) 100%
  );
  border: 1rpx solid rgba(184, 169, 211, 0.25);
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-shadow: 0 8rpx 24rpx rgba(139, 123, 168, 0.18);
}

.save-button.enabled {
  background: linear-gradient(135deg, #b8a9d3 0%, #e8c4b8 100%);
  border-color: rgba(255, 255, 255, 0.6);
  box-shadow:
    0 12rpx 30rpx rgba(184, 169, 211, 0.35),
    0 8rpx 20rpx rgba(232, 196, 184, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}

.save-button.button-hover {
  transform: translateY(-3rpx);
  box-shadow:
    0 14rpx 34rpx rgba(184, 169, 211, 0.35),
    0 10rpx 22rpx rgba(232, 196, 184, 0.25);
}

.button-shimmer {
  position: absolute;
  top: -50%;
  left: -120%;
  width: 220%;
  height: 200%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.35) 50%,
    transparent 100%
  );
  transform: skewX(-18deg);
  animation: shimmer-slide 3.2s ease-in-out infinite;
  opacity: 0.6;
}

@keyframes shimmer-slide {
  0%, 100% {
    left: -120%;
  }
  50% {
    left: 120%;
  }
}

.button-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
  position: relative;
  z-index: 1;
}

.button-icon {
  font-size: 30rpx;
  color: rgba(107, 95, 122, 0.7);
  transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.save-button.enabled .button-icon {
  color: #2d2a32;
  text-shadow: 0 2rpx 6rpx rgba(255, 255, 255, 0.4);
  animation: icon-float 3.4s ease-in-out infinite;
}

@keyframes icon-float {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-4rpx) rotate(8deg);
  }
}

.button-text {
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans CJK SC', sans-serif;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: rgba(107, 95, 122, 0.7);
  transition: color 0.3s ease;
}

.save-button.enabled .button-text {
  color: #2d2a32;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.35);
}

.button-pulse {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 100%;
  border-radius: 22rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  animation: pulse-expand 2.2s ease-out infinite;
  pointer-events: none;
}

@keyframes pulse-expand {
  0% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) scale(1.12);
    opacity: 0;
  }
}
