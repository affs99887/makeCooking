/**recordDrawer.wxss**/

/* ========== 遮罩层 ========== */
.drawer-mask {
  --cream: #faf8f5;
  --lavender: #b8a9d3;
  --lavender-deep: #8b7ba8;
  --rose: #e8c4b8;
  --gold: #d4a574;
  --ink: #2d2a32;
  --ink-soft: #6b5f7a;
  --ink-muted: #9b8fa8;
  --glass: rgba(255, 255, 255, 0.78);
  --glass-strong: rgba(255, 255, 255, 0.92);
  --mask-blur: 20rpx;

  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: radial-gradient(
    120% 90% at 50% 0%,
    rgba(232, 196, 184, 0.25) 0%,
    rgba(184, 169, 211, 0.2) 40%,
    rgba(45, 42, 50, 0.35) 100%
  );
  backdrop-filter: blur(var(--mask-blur)) saturate(140%);
  z-index: 9998;
  opacity: 0;
  transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.drawer-mask.show {
  opacity: 1;
}

/* ========== 抽屉容器 ========== */
.drawer-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100vw;
  max-width: 100vw;
  height: 100vh;
  max-height: 100vh;
  background: linear-gradient(
    180deg,
    rgba(250, 248, 245, 0.98) 0%,
    rgba(244, 240, 248, 0.96) 100%
  );
  border-radius: 48rpx 48rpx 0 0;
  border: 1rpx solid rgba(184, 169, 211, 0.22);
  box-shadow:
    0 -14rpx 60rpx rgba(139, 123, 168, 0.18),
    0 -4rpx 18rpx rgba(45, 42, 50, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  opacity: 0;
  filter: blur(12rpx);
  transition:
    transform 0.75s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.45s ease,
    filter 0.7s ease,
    border-radius 0.6s ease,
    box-shadow 0.6s ease;
  will-change: transform;
  overflow: hidden;
  backdrop-filter: blur(26rpx) saturate(150%);
  box-sizing: border-box;
  transform-origin: center bottom;
}

.drawer-container.is-open {
  opacity: 1;
  filter: blur(0);
}

.drawer-container.is-dragging {
  transition: none;
}

.drawer-container.is-expanded {
  border-radius: 28rpx 28rpx 0 0;
  box-shadow:
    0 -18rpx 70rpx rgba(139, 123, 168, 0.2),
    0 -6rpx 24rpx rgba(45, 42, 50, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.drawer-ambient {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.ambient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(45rpx);
  opacity: 0.65;
  animation: orb-float 20s ease-in-out infinite;
}

.orb-left {
  width: 320rpx;
  height: 320rpx;
  left: -120rpx;
  top: -160rpx;
  background: radial-gradient(
    circle,
    rgba(184, 169, 211, 0.5) 0%,
    rgba(184, 169, 211, 0.1) 60%,
    transparent 75%
  );
}

.orb-right {
  width: 260rpx;
  height: 260rpx;
  right: -100rpx;
  top: 40rpx;
  background: radial-gradient(
    circle,
    rgba(232, 196, 184, 0.45) 0%,
    rgba(232, 196, 184, 0.12) 60%,
    transparent 75%
  );
  animation-delay: 4s;
}

.ambient-sheen {
  position: absolute;
  top: -50%;
  left: -30%;
  width: 160%;
  height: 80%;
  transform: rotate(-6deg);
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.55) 0%,
    rgba(255, 255, 255, 0) 60%
  );
  opacity: 0.7;
}

@keyframes orb-float {
  0%, 100% {
    transform: translateY(0) translateX(0);
  }
  50% {
    transform: translateY(18rpx) translateX(10rpx);
  }
}

.drawer-handle,
.drawer-header,
.drawer-content {
  position: relative;
  z-index: 1;
}

/* 顶部拖动条 */
.drawer-handle {
  width: 100%;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 18rpx;
}

.handle-pill {
  width: 84rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: linear-gradient(
    90deg,
    rgba(184, 169, 211, 0.3),
    rgba(184, 169, 211, 0.7),
    rgba(232, 196, 184, 0.4)
  );
  box-shadow: 0 4rpx 12rpx rgba(184, 169, 211, 0.25);
}

/* ========== 标题区域 ========== */
.drawer-header {
  position: relative;
  padding: 24rpx 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  animation: header-rise 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.2s forwards;
}

.header-soften {
  position: absolute;
  left: -32rpx;
  right: -32rpx;
  bottom: -18rpx;
  height: 36rpx;
  background: linear-gradient(
    180deg,
    rgba(250, 248, 245, 0.9) 0%,
    rgba(250, 248, 245, 0.6) 60%,
    rgba(250, 248, 245, 0) 100%
  );
  backdrop-filter: blur(14rpx);
  pointer-events: none;
}

@keyframes header-rise {
  from {
    opacity: 0;
    transform: translateY(-16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.header-orb {
  position: absolute;
  width: 180rpx;
  height: 120rpx;
  border-radius: 50%;
  filter: blur(32rpx);
  opacity: 0.7;
}

.header-orb-left {
  left: 6rpx;
  top: -10rpx;
  background: radial-gradient(
    circle,
    rgba(184, 169, 211, 0.4),
    transparent 70%
  );
}

.header-orb-right {
  right: 0;
  top: -16rpx;
  background: radial-gradient(
    circle,
    rgba(232, 196, 184, 0.35),
    transparent 70%
  );
}

.drawer-title {
  font-family: 'Georgia', 'Times New Roman', 'SourceHanSerifCN', serif;
  font-size: 50rpx;
  font-weight: 300;
  letter-spacing: 2rpx;
  color: var(--ink);
  margin-bottom: 10rpx;
  text-shadow: 0 6rpx 24rpx rgba(184, 169, 211, 0.25);
}

.drawer-subtitle {
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans CJK SC', sans-serif;
  font-size: 22rpx;
  font-weight: 300;
  letter-spacing: 3rpx;
  color: var(--ink-muted);
}

.header-divider {
  margin-top: 18rpx;
  width: 120rpx;
  height: 3rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(184, 169, 211, 0.6) 50%,
    transparent 100%
  );
}

/* ========== 滚动内容区 ========== */
.drawer-content {
  flex: 1;
  overflow-y: auto;
  padding: 0 28rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}


/* ========== 区块样式 ========== */
.section-block {
  margin-bottom: 28rpx;
  padding: 24rpx;
  background: var(--glass);
  border: 1rpx solid rgba(184, 169, 211, 0.2);
  border-radius: 24rpx;
  box-shadow:
    0 12rpx 32rpx rgba(139, 123, 168, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  opacity: 0;
  animation: section-reveal 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  box-sizing: border-box;
}

.section-block:nth-child(1) {
  animation-delay: 0.25s;
}

.section-block:nth-child(2) {
  animation-delay: 0.35s;
}

.section-block:nth-child(3) {
  animation-delay: 0.45s;
}

.section-block:nth-child(4) {
  animation-delay: 0.55s;
}

@keyframes section-reveal {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.section-block.section-exit {
  animation: section-exit 0.36s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  animation-delay: 0s;
  pointer-events: none;
}

@keyframes section-exit {
  from {
    opacity: 1;
    transform: translateY(0);
  }
  to {
    opacity: 0;
    transform: translateY(18rpx);
  }
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 12rpx;
}

.section-icon {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--lavender), var(--rose));
  box-shadow: 0 0 12rpx rgba(184, 169, 211, 0.5);
}

.section-title {
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans CJK SC', sans-serif;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.section-hint {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--ink-muted);
  font-weight: 300;
}

/* ========== 烹饪风格选择（叠加卡片） ========== */
.type-section {
  background: var(--glass);
  border-color: rgba(184, 169, 211, 0.2);
  box-shadow:
    0 12rpx 32rpx rgba(139, 123, 168, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.type-header {
  margin-bottom: 18rpx;
}

.type-header .section-hint {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(232, 196, 184, 0.12);
  border: 1rpx solid rgba(232, 196, 184, 0.22);
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: var(--lavender-deep);
  box-shadow: none;
}

.type-deck {
  position: relative;
  padding: 16rpx;
  border-radius: 26rpx;
  background: linear-gradient(160deg, #ffffff 0%, #f6f2fb 100%);
  border: 1rpx solid rgba(184, 169, 211, 0.24);
  box-shadow: none;
  overflow: hidden;
}

.type-deck::before {
  content: none;
}

.type-deck::after {
  content: none;
}

.type-grid {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  z-index: 1;
}

.type-card {
  position: relative;
  flex: 1 1 calc(50% - 8rpx);
  min-width: 240rpx;
  height: 164rpx;
  border-radius: 24rpx;
  padding: 18rpx 20rpx 16rpx 22rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #ffffff 0%, rgba(184, 169, 211, 0.06) 100%);
  border: 1rpx solid rgba(184, 169, 211, 0.2);
  box-shadow: none;
  overflow: hidden;
  transition:
    transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1),
    border-color 0.3s ease;
}

.type-card::before {
  content: none;
}

.type-card.active {
  transform: translateY(0);
  border-color: rgba(184, 169, 211, 0.55);
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.96) 0%, rgba(184, 169, 211, 0.28) 100%);
  box-shadow: none;
}

.type-card.active::after {
  content: none;
}

.type-card.active::before {
  content: none;
}

.type-card-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  text-align: center;
}

.type-check {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(184, 169, 211, 0.3);
  background: rgba(255, 255, 255, 0.7);
  opacity: 0;
  transform: scale(0.7);
  transition: all 0.3s ease;
}

.type-check::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 10rpx;
  height: 18rpx;
  border-right: 3rpx solid rgba(139, 123, 168, 0.85);
  border-bottom: 3rpx solid rgba(139, 123, 168, 0.85);
  transform: translate(-50%, -60%) rotate(45deg);
}

.type-card.active .type-check {
  opacity: 1;
  transform: scale(1);
  border-color: rgba(184, 169, 211, 0.55);
  background: linear-gradient(160deg, #ffffff 0%, rgba(184, 169, 211, 0.2) 100%);
}

.type-name-cn {
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans CJK SC', sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.type-name-en {
  font-family: 'Avenir Next', 'Avenir', 'PingFang SC', sans-serif;
  font-size: 16rpx;
  font-weight: 600;
  color: var(--ink-muted);
  letter-spacing: 2rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(184, 169, 211, 0.2);
  background: rgba(184, 169, 211, 0.08);
}

.type-card.active .type-name-cn {
  color: var(--lavender-deep);
}

.type-card.active .type-name-en {
  color: var(--lavender-deep);
  border-color: rgba(184, 169, 211, 0.4);
  background: linear-gradient(160deg, #ffffff 0%, rgba(184, 169, 211, 0.22) 100%);
}

.type-count {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  min-width: 44rpx;
  height: 28rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(160deg, #ffffff 0%, rgba(184, 169, 211, 0.2) 100%);
  border: 2rpx solid rgba(184, 169, 211, 0.4);
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  animation: count-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.type-count-text {
  font-size: 18rpx;
  font-weight: 600;
  color: #8b7ba8;
  letter-spacing: 0.5rpx;
}

@keyframes count-pop {
  0% {
    transform: scale(0.5);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* ========== 烹饪手法选择 ========== */

.method-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.method-item {
  position: relative;
  flex: 1 1 calc(33.33% - 10rpx);
  min-width: 180rpx;
  height: 96rpx;
  background: linear-gradient(160deg, #ffffff 0%, rgba(184, 169, 211, 0.06) 100%);
  border: 1rpx solid rgba(184, 169, 211, 0.2);
  border-radius: 999rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  overflow: hidden;
  box-shadow: none;
}

.method-item::before {
  content: none;
}

.method-item::after {
  content: none;
}

.method-item.active {
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.96) 0%, rgba(184, 169, 211, 0.26) 100%);
  border-color: rgba(184, 169, 211, 0.5);
  box-shadow: none;
  transform: translateY(0);
}

.method-info {
  flex: 0 1 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.method-check {
  position: absolute;
  right: 14rpx;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(184, 169, 211, 0.3);
  background: rgba(255, 255, 255, 0.7);
  opacity: 0;
  transform: translateY(-50%) scale(0.7);
  transition: all 0.3s ease;
}

.method-check::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 8rpx;
  height: 14rpx;
  border-right: 3rpx solid rgba(139, 123, 168, 0.85);
  border-bottom: 3rpx solid rgba(139, 123, 168, 0.85);
  transform: translate(-50%, -60%) rotate(45deg);
}

.method-item.active .method-check {
  opacity: 1;
  transform: translateY(-50%) scale(1);
  border-color: rgba(184, 169, 211, 0.55);
  background: linear-gradient(160deg, #ffffff 0%, rgba(184, 169, 211, 0.2) 100%);
}

.method-label-cn {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.method-label-en {
  font-size: 16rpx;
  font-weight: 600;
  color: var(--ink-muted);
  letter-spacing: 2rpx;
  line-height: 1.2;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(184, 169, 211, 0.2);
  background: rgba(184, 169, 211, 0.08);
}

.method-item.active .method-label-cn,
.method-item.active .method-label-en {
  color: var(--lavender-deep);
  text-shadow: none;
}

.method-item.active .method-label-en {
  border-color: rgba(184, 169, 211, 0.4);
  background: linear-gradient(160deg, #ffffff 0%, rgba(184, 169, 211, 0.22) 100%);
}

.method-subtitle {
  font-size: 20rpx;
  font-weight: 300;
  color: var(--ink-muted);
  letter-spacing: 1rpx;
}

/* ========== 时间选择 ========== */
.datetime-summary {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  width: 100%;
}

.datetime-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.datetime-main {
  font-family: 'Georgia', 'Times New Roman', 'SourceHanSerifCN', serif;
  font-size: 28rpx;
  color: var(--ink);
  letter-spacing: 1.5rpx;
}

.datetime-sub {
  font-size: 20rpx;
  color: var(--ink-muted);
  letter-spacing: 1rpx;
}

.datetime-edit-button {
  margin: 0 0 0 auto;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(184, 169, 211, 0.3);
  background: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  color: var(--lavender-deep);
  letter-spacing: 1rpx;
  line-height: 1.6;
}

.datetime-edit-button.datetime-edit-hover {
  transform: translateY(-2rpx);
}

.datetime-editor {
  margin-top: 18rpx;
  animation: datetimeFade 0.3s ease forwards;
}

@keyframes datetimeFade {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.datetime-row {
  display: flex;
  gap: 14rpx;
}

.datetime-picker {
  flex: 1;
}

.datetime-card {
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(160deg, #ffffff 0%, rgba(184, 169, 211, 0.08) 100%);
  border: 1rpx solid rgba(184, 169, 211, 0.2);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-sizing: border-box;
}

.datetime-label {
  font-size: 20rpx;
  color: var(--ink-muted);
  letter-spacing: 1rpx;
}

.datetime-value {
  font-family: 'Georgia', 'Times New Roman', 'SourceHanSerifCN', serif;
  font-size: 28rpx;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.drawer-container.is-readonly .datetime-card {
  opacity: 0.75;
}


/* ========== 评分系统 ========== */
.score-shell {
  overflow: hidden;
  max-height: 0;
  padding-bottom: 0;
  transition:
    max-height 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94),
    padding-bottom 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.score-shell.is-open {
  max-height: 2000rpx;
  padding-bottom: 28rpx;
}

.score-section {
  margin-bottom: 0;
  opacity: 0;
  transform: translateY(18rpx);
  animation: none;
  pointer-events: none;
  transition:
    opacity 0.2s ease,
    transform 0.2s ease;
}

.score-section.is-visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.score-header .section-hint {
  margin-left: 0;
}

.score-header-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.score-toggle {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--lavender-deep);
  background: rgba(184, 169, 211, 0.12);
  border: 1rpx solid rgba(184, 169, 211, 0.3);
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.score-toggle-hover {
  background: rgba(184, 169, 211, 0.2);
}

.score-total-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(
    135deg,
    rgba(184, 169, 211, 0.18) 0%,
    rgba(232, 196, 184, 0.12) 100%
  );
  border: 1rpx solid rgba(184, 169, 211, 0.22);
}

.score-total-label {
  font-size: 22rpx;
  color: var(--ink-muted);
  letter-spacing: 2rpx;
}

.score-total-display {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.score-total-value {
  font-family: 'Georgia', 'Times New Roman', 'SourceHanSerifCN', serif;
  font-size: 48rpx;
  font-weight: 300;
  color: var(--lavender-deep);
  letter-spacing: -1rpx;
}

.score-total-unit {
  font-size: 22rpx;
  color: var(--ink-soft);
}

.score-type-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.score-type-item {
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(160deg, #ffffff 0%, rgba(245, 240, 251, 0.9) 100%);
  border: 1rpx solid rgba(184, 169, 211, 0.2);
}

.score-type-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.score-type-name {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.score-type-count {
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  color: var(--lavender-deep);
  background: rgba(184, 169, 211, 0.16);
  border: 1rpx solid rgba(184, 169, 211, 0.2);
}

.score-type-score {
  margin-left: auto;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.score-type-number {
  font-family: 'Georgia', 'Times New Roman', 'SourceHanSerifCN', serif;
  font-size: 32rpx;
  color: var(--lavender-deep);
  letter-spacing: -1rpx;
}

.score-type-max {
  font-size: 20rpx;
  color: rgba(155, 143, 168, 0.7);
}

.score-type-slider {
  padding-top: 18rpx;
  margin-bottom: 6rpx;
}

.score-display {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 32rpx;
  padding: 26rpx;
  background: linear-gradient(
    135deg,
    rgba(184, 169, 211, 0.16) 0%,
    rgba(232, 196, 184, 0.12) 100%
  );
  border-radius: 20rpx;
  border: 1rpx solid rgba(184, 169, 211, 0.2);
}

.score-value {
  font-family: 'Georgia', 'Times New Roman', 'SourceHanSerifCN', serif;
  font-size: 80rpx;
  font-weight: 300;
  color: var(--lavender-deep);
  letter-spacing: -2rpx;
  display: inline-block;
  text-shadow:
    0 6rpx 18rpx rgba(184, 169, 211, 0.35),
    0 0 30rpx rgba(184, 169, 211, 0.2);
  animation: score-glow 2.2s ease-in-out infinite;
}

.score-pop-a,
.score-pop-b {
  animation:
    score-glow 2.2s ease-in-out infinite,
    score-pop 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes score-pop {
  0% {
    transform: scale(0.96);
    opacity: 0.75;
  }
  55% {
    transform: scale(1.06);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes score-glow {
  0%, 100% {
    text-shadow:
      0 6rpx 18rpx rgba(184, 169, 211, 0.35),
      0 0 30rpx rgba(184, 169, 211, 0.2);
  }
  50% {
    text-shadow:
      0 6rpx 22rpx rgba(184, 169, 211, 0.5),
      0 0 40rpx rgba(184, 169, 211, 0.35);
  }
}

.score-unit {
  font-size: 30rpx;
  color: var(--ink-soft);
  font-weight: 300;
}

.score-max {
  font-size: 24rpx;
  color: rgba(155, 143, 168, 0.7);
  font-weight: 300;
}

.slider-container {
  position: relative;
  padding: 22rpx 0 10rpx;
  margin-bottom: 8rpx;
}

.slider-rail {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  height: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(
    90deg,
    rgba(184, 169, 211, 0.18),
    rgba(232, 196, 184, 0.18)
  );
  border: 1rpx solid rgba(184, 169, 211, 0.2);
  z-index: 0;
}

.slider-fill {
  position: absolute;
  left: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  height: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #b8a9d3 0%, #e8c4b8 100%);
  z-index: 1;
}

.slider-glow {
  position: absolute;
  left: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  height: 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(184, 169, 211, 0.6), rgba(232, 196, 184, 0.45));
  filter: blur(12rpx);
  opacity: 0.8;
  z-index: 0;
  pointer-events: none;
}

.score-slider {
  width: calc(100% - 32rpx);
  margin: 0 16rpx;
  position: relative;
  z-index: 3;
  height: 40rpx;
}

.score-slider .wx-slider-inner {
  height: 14rpx;
  background: transparent;
}

.score-slider .wx-slider-bar {
  background: transparent;
}

.score-slider .wx-slider-track {
  background: transparent;
}

.score-slider .wx-slider-handle {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #ffffff 0%, rgba(184, 169, 211, 0.22) 100%);
  border: 2rpx solid rgba(184, 169, 211, 0.5);
  box-shadow:
    0 8rpx 18rpx rgba(139, 123, 168, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.score-markers {
  display: flex;
  justify-content: space-between;
  padding: 0 2rpx;
}

.marker {
  font-size: 18rpx;
  color: rgba(155, 143, 168, 0.6);
  font-weight: 300;
}

/* ========== 底部操作区 ========== */
.section-spacer {
  height: 160rpx;
  transition: height 0.25s ease;
}

.drawer-container.is-dragging .section-spacer {
  transition: none;
}

.drawer-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 22rpx 32rpx;
  padding-bottom: calc(22rpx + env(safe-area-inset-bottom));
  background: linear-gradient(
    180deg,
    rgba(250, 248, 245, 0) 0%,
    rgba(250, 248, 245, 0.9) 30%,
    rgba(250, 248, 245, 0.98) 100%
  );
  box-sizing: border-box;
  z-index: 10000;
  opacity: 0;
  transform: translateY(24rpx);
  transition:
    opacity 0.35s ease,
    transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  pointer-events: none;
}

.drawer-footer.is-open {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.footer-glow {
  position: absolute;
  top: -70rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 320rpx;
  height: 90rpx;
  background: radial-gradient(
    ellipse at center,
    rgba(184, 169, 211, 0.18) 0%,
    transparent 70%
  );
  filter: blur(30rpx);
  pointer-events: none;
}

.footer-actions {
  display: flex;
  gap: 16rpx;
}

.action-button {
  flex: 1;
  height: 92rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(184, 169, 211, 0.24);
  background: rgba(255, 255, 255, 0.92);
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans CJK SC', sans-serif;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: rgba(107, 95, 122, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(139, 123, 168, 0.12);
  transition: all 0.3s ease;
}

.action-button.edit-button {
  background: linear-gradient(
    135deg,
    rgba(184, 169, 211, 0.35) 0%,
    rgba(232, 196, 184, 0.25) 100%
  );
  border-color: rgba(184, 169, 211, 0.32);
  color: #2d2a32;
}

.action-button.delete-button {
  border-color: rgba(232, 196, 184, 0.5);
  color: rgba(139, 86, 86, 0.9);
}

.action-button.action-hover {
  transform: translateY(-3rpx);
  box-shadow: 0 12rpx 26rpx rgba(139, 123, 168, 0.16);
}

.save-button {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.9) 0%,
    rgba(244, 240, 248, 0.92) 100%
  );
  border: 1rpx solid rgba(184, 169, 211, 0.25);
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-shadow: 0 8rpx 24rpx rgba(139, 123, 168, 0.18);
}

.save-button.enabled {
  background: linear-gradient(135deg, #b8a9d3 0%, #e8c4b8 100%);
  border-color: rgba(255, 255, 255, 0.6);
  box-shadow:
    0 12rpx 30rpx rgba(184, 169, 211, 0.35),
    0 8rpx 20rpx rgba(232, 196, 184, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}

.save-button.button-hover {
  transform: translateY(-3rpx);
  box-shadow:
    0 14rpx 34rpx rgba(184, 169, 211, 0.35),
    0 10rpx 22rpx rgba(232, 196, 184, 0.25);
}

.button-shimmer {
  position: absolute;
  top: -50%;
  left: -120%;
  width: 220%;
  height: 200%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.35) 50%,
    transparent 100%
  );
  transform: skewX(-18deg);
  animation: shimmer-slide 3.2s ease-in-out infinite;
  opacity: 0.6;
}

@keyframes shimmer-slide {
  0%, 100% {
    left: -120%;
  }
  50% {
    left: 120%;
  }
}

.button-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
  position: relative;
  z-index: 1;
}

.button-icon {
  font-size: 30rpx;
  color: rgba(107, 95, 122, 0.7);
  transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.save-button.enabled .button-icon {
  color: #2d2a32;
  text-shadow: 0 2rpx 6rpx rgba(255, 255, 255, 0.4);
  animation: icon-float 3.4s ease-in-out infinite;
}

@keyframes icon-float {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-4rpx) rotate(8deg);
  }
}

.button-text {
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans CJK SC', sans-serif;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: rgba(107, 95, 122, 0.7);
  transition: color 0.3s ease;
}

.save-button.enabled .button-text {
  color: #2d2a32;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.35);
}

.button-pulse {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 100%;
  border-radius: 22rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  animation: pulse-expand 2.2s ease-out infinite;
  pointer-events: none;
}

@keyframes pulse-expand {
  0% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) scale(1.12);
    opacity: 0;
  }
}
