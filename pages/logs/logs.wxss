@import "../../styles/theme.wxss";

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  height: 100%;
  overflow-y: hidden;
  background: rgb(var(--background-rgb));
  color: var(--ink);
}
.log-item {
  margin-top: 20rpx;
  text-align: center;
}
.log-item:last-child {
  padding-bottom: env(safe-area-inset-bottom);
}
