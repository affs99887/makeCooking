/**home.wxss**/

/* 全局页面配置 */
page {
  height: 100vh;
  background: linear-gradient(165deg, #f7f5f2 0%, #ebe7e0 100%);
  overflow: hidden;
  animation: page-appear 0.8s cubic-bezier(0.23, 1, 0.32, 1);
}

@keyframes page-appear {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 主容器 */
.page {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  position: relative;
}

/* 内容区域 */
.content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: contentReveal 1s cubic-bezier(0.23, 1, 0.32, 1) 0.1s backwards;
}

@keyframes contentReveal {
  from {
    opacity: 0;
    transform: translateY(20rpx) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 日期显示 */
.date-display {
  font-family: 'Georgia', 'Times New Roman', serif;
  font-size: 28rpx;
  color: #a39a8f;
  letter-spacing: 2rpx;
  margin-bottom: 100rpx;
  opacity: 0;
  animation: gentleReveal 1.1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s forwards;
}

@keyframes gentleReveal {
  from {
    opacity: 0;
    transform: translateY(-15rpx);
    filter: blur(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

/* 问候语容器 */
.greeting-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 180rpx;
  text-align: center;
  animation: gentleFloat 6s ease-in-out infinite;
  animation-delay: 2s;
}

@keyframes gentleFloat {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

/* 主问候语 */
.greeting {
  font-family: 'Georgia', 'Palatino', 'Times New Roman', serif;
  font-size: 56rpx;
  font-weight: 400;
  color: #3d3731;
  line-height: 1.4;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
  opacity: 0;
  animation: poeticRise 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s forwards;
}

@keyframes poeticRise {
  from {
    opacity: 0;
    transform: translateY(35rpx) scale(0.96);
    filter: blur(10rpx);
  }
  60% {
    filter: blur(2rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
}

/* 副标题 */
.subtitle {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: 30rpx;
  font-weight: 300;
  color: #8b8279;
  letter-spacing: 1rpx;
  opacity: 0;
  animation: subtleFade 1s cubic-bezier(0.23, 1, 0.32, 1) 0.8s forwards;
}

@keyframes subtleFade {
  from {
    opacity: 0;
    transform: translateY(20rpx);
    filter: blur(6rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

/* 按钮容器 */
.action-container {
  width: 100%;
  display: flex;
  justify-content: center;
  opacity: 0;
  animation: buttonEmerge 1.3s cubic-bezier(0.34, 1.56, 0.64, 1) 1s forwards;
}

@keyframes buttonEmerge {
  from {
    opacity: 0;
    transform: translateY(40rpx) scale(0.92);
    filter: blur(8rpx);
  }
  70% {
    filter: blur(1rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
}

/* 添加记录按钮 */
.add-button {
  background: linear-gradient(135deg, #3d3731 0%, #4a4239 100%);
  border: none;
  border-radius: 60rpx;
  padding: 0;
  width: 440rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 8rpx 32rpx rgba(61, 55, 49, 0.15),
    0 2rpx 8rpx rgba(61, 55, 49, 0.08),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.1);
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  overflow: hidden;
  will-change: transform, box-shadow;
}

.add-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.08) 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.add-button::after {
  content: '';
}

.add-button-hover {
  transform: translateY(-6rpx) scale(1.02);
  box-shadow:
    0 16rpx 48rpx rgba(61, 55, 49, 0.25),
    0 6rpx 16rpx rgba(61, 55, 49, 0.15),
    inset 0 1rpx 3rpx rgba(255, 255, 255, 0.15);
}

.add-button-hover::before {
  opacity: 1;
}

/* 按钮内容 */
.button-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

/* 按钮图标 */
.button-icon {
  font-size: 36rpx;
  color: #e8dfd4;
  line-height: 1;
  animation: gentleSparkle 4s ease-in-out infinite;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.2));
  will-change: transform, opacity;
}

@keyframes gentleSparkle {
  0%, 100% {
    opacity: 0.7;
    transform: rotate(0deg) scale(1);
  }
  50% {
    opacity: 1;
    transform: rotate(180deg) scale(1.1);
  }
}

/* 按钮文字 */
.button-text {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: 32rpx;
  font-weight: 500;
  color: #f7f5f2;
  letter-spacing: 3rpx;
}

/* 装饰线 */
.decorative-line {
  position: absolute;
  bottom: 120rpx;
  width: 120rpx;
  height: 1rpx;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(163, 154, 143, 0.3) 50%,
    transparent 100%);
  opacity: 0;
  animation: lineExpand 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) 1.3s forwards;
}

@keyframes lineExpand {
  from {
    opacity: 0;
    width: 0;
  }
  to {
    opacity: 1;
    width: 120rpx;
  }
}

/* 动画定义（保留用于兼容性） */

/* ========== 优雅极简 - 底部Tab栏 ========== */
.floating-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 0 48rpx calc(env(safe-area-inset-bottom) + 20rpx);
  z-index: 999;
  pointer-events: none;
  display: flex;
  justify-content: center;
  align-items: center;
  opacity: 0;
  animation: tabBarRise 1s cubic-bezier(0.34, 1.56, 0.64, 1) 1.4s forwards;
}

@keyframes tabBarRise {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.tab-capsule {
  position: relative;
  pointer-events: auto;
  display: flex;
  padding: 8rpx;
  gap: 0;
  border-radius: 56rpx;
  overflow: visible;
  min-width: 440rpx;

  /* 毛玻璃效果 - 温暖米色调 */
  background: rgba(247, 245, 242, 0.75);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);

  /* 精致边框 - 棕色调 */
  border: 1rpx solid rgba(163, 154, 143, 0.15);

  /* 多层阴影 - 温暖棕色 */
  box-shadow:
    0 0 0 1rpx rgba(139, 130, 121, 0.06) inset,
    0 16rpx 48rpx rgba(61, 55, 49, 0.08),
    0 6rpx 20rpx rgba(139, 130, 121, 0.06),
    0 2rpx 6rpx rgba(163, 154, 143, 0.04);

  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.tab-capsule::before {
  content: '';
  position: absolute;
  top: -1rpx;
  left: -1rpx;
  right: -1rpx;
  bottom: -1rpx;
  border-radius: 56rpx;
  background: linear-gradient(135deg,
    rgba(163, 154, 143, 0.12) 0%,
    rgba(139, 130, 121, 0.08) 50%,
    rgba(163, 154, 143, 0.12) 100%);
  z-index: -1;
  opacity: 0.5;
  filter: blur(6rpx);
}

.tab-capsule::after {
  content: '';
  position: absolute;
  top: 0;
  left: 25%;
  right: 25%;
  height: 1.5rpx;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.6) 50%,
    transparent 100%);
  border-radius: 56rpx 56rpx 0 0;
  opacity: 0.5;
}

/* 活动指示器 - 温暖棕色调 */
.ink-flow-indicator {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: calc(50% - 6rpx);
  height: calc(100% - 12rpx);
  border-radius: 50rpx;
  background: linear-gradient(135deg,
    rgba(61, 55, 49, 0.12) 0%,
    rgba(74, 66, 57, 0.08) 100%);
  box-shadow:
    0 0 16rpx rgba(139, 130, 121, 0.15) inset,
    0 6rpx 16rpx rgba(61, 55, 49, 0.1);
  transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 0;
}

.ink-flow-indicator::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50rpx;
  background: linear-gradient(45deg,
    rgba(163, 154, 143, 0.15) 0%,
    rgba(139, 130, 121, 0.12) 25%,
    rgba(163, 154, 143, 0.1) 50%,
    rgba(139, 130, 121, 0.12) 75%,
    rgba(163, 154, 143, 0.15) 100%);
  background-size: 300% 300%;
  animation: inkFlow 10s ease-in-out infinite;
  opacity: 0.5;
}

@keyframes inkFlow {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

/* Tab 项目 */
.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx 48rpx;
  border-radius: 50rpx;
  z-index: 1;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.tab-item:active {
  transform: scale(0.94);
}

/* 墨滴涟漪图标 */
.tab-icon-wrapper {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-today {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 中心圆点 - 温暖棕色 */
.ink-drop {
  width: 8rpx;
  height: 8rpx;
  background: radial-gradient(circle, #a39a8f 0%, #8b8279 100%);
  border-radius: 50%;
  position: absolute;
  z-index: 3;
  box-shadow: 0 0 6rpx rgba(163, 154, 143, 0.3);
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

/* 涟漪圆环 - 棕色调 */
.ripple {
  position: absolute;
  border-radius: 50%;
  border: 1rpx solid #a39a8f;
  opacity: 0.25;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.ripple-1 {
  width: 18rpx;
  height: 18rpx;
  z-index: 2;
}

.ripple-2 {
  width: 28rpx;
  height: 28rpx;
  z-index: 1;
}

.ripple-3 {
  width: 40rpx;
  height: 40rpx;
  z-index: 0;
}

/* 激活态 - 圆点强调 */
.tab-item.active .ink-drop {
  background: radial-gradient(circle, #6b5f54 0%, #5a4e43 100%);
  box-shadow: 0 0 12rpx rgba(107, 95, 84, 0.4);
  animation: inkDropPulse 2.5s ease-in-out infinite;
}

@keyframes inkDropPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.3);
    opacity: 0.85;
  }
}

/* 激活态 - 涟漪扩散 */
.tab-item.active .ripple {
  border-color: #6b5f54;
  border-width: 1.5rpx;
}

.tab-item.active .ripple-1 {
  animation: rippleExpand 6s ease-out infinite;
  animation-delay: 0s;
}

.tab-item.active .ripple-2 {
  animation: rippleExpand 6s ease-out infinite;
  animation-delay: 1s;
}

.tab-item.active .ripple-3 {
  animation: rippleExpand 6s ease-out infinite;
  animation-delay: 2s;
}

@keyframes rippleExpand {
  0% {
    transform: scale(0.7);
    opacity: 0;
  }
  35% {
    opacity: 0.5;
  }
  100% {
    transform: scale(1.3);
    opacity: 0;
  }
}

/* 非激活态效果 */
.tab-item:not(.active) .ink-drop {
  opacity: 0.7;
}

.tab-item:not(.active) .ripple {
  opacity: 0.2;
}

/* 柱状图图标 - 温暖棕色调 */
.icon-chart {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 3rpx;
  height: 38rpx;
  padding: 4rpx 0;
}

.chart-bar {
  width: 6rpx;
  border-radius: 5rpx 5rpx 2rpx 2rpx;
  background: linear-gradient(180deg,
    rgba(163, 154, 143, 0.5) 0%,
    rgba(163, 154, 143, 0.25) 100%);
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.bar-1 { height: 14rpx; animation-delay: 0s; }
.bar-2 { height: 24rpx; animation-delay: 0.1s; }
.bar-3 { height: 32rpx; animation-delay: 0.2s; }
.bar-4 { height: 20rpx; animation-delay: 0.3s; }

.tab-item.active .chart-bar {
  background: linear-gradient(180deg,
    rgba(107, 95, 84, 0.75) 0%,
    rgba(139, 130, 121, 0.5) 100%);
  box-shadow: 0 0 6rpx rgba(107, 95, 84, 0.3);
  animation: barBounce 1.8s ease-in-out infinite;
}

@keyframes barBounce {
  0%, 100% { transform: scaleY(1); }
  50% { transform: scaleY(1.15); }
}

/* Tab 文字 - 衬线字体 */
.tab-label {
  font-family: 'Georgia', 'Palatino', 'Times New Roman', serif;
  font-size: 22rpx;
  font-weight: 400;
  color: #8b8279;
  letter-spacing: 0.5rpx;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  opacity: 0.65;
}

.tab-item.active .tab-label {
  color: #3d3731;
  font-weight: 500;
  opacity: 1;
  transform: scale(1.03);
  text-shadow: 0 1rpx 4rpx rgba(61, 55, 49, 0.1);
}

/* 脉冲光晕 - 温暖棕色 */
.pulse-halo {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 130%;
  height: 130%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle,
    rgba(163, 154, 143, 0.08) 0%,
    rgba(139, 130, 121, 0.05) 50%,
    transparent 100%);
  z-index: -1;
  animation: pulsate 3s ease-in-out infinite;
  pointer-events: none;
}

@keyframes pulsate {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.6;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.1);
    opacity: 0.35;
  }
}

/* 装饰性漂浮粒子 - 极简棕色 */
.float-particle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle,
    rgba(163, 154, 143, 0.15) 0%,
    rgba(139, 130, 121, 0.08) 100%);
  pointer-events: none;
  z-index: -1;
  filter: blur(20rpx);
  animation: floatAround 20s ease-in-out infinite;
  opacity: 0;
  will-change: transform, opacity;
}

/* 粒子尺寸和位置 */
.particle-1 {
  width: 32rpx;
  height: 32rpx;
  bottom: 55rpx;
  left: 12%;
  animation: floatAround 20s ease-in-out 0s infinite,
             particleFadeIn 1.5s ease-out 2s forwards;
}

.particle-2 {
  width: 48rpx;
  height: 48rpx;
  bottom: 70rpx;
  right: 18%;
  animation: floatAround 20s ease-in-out -6s infinite,
             particleFadeIn 1.5s ease-out 2.3s forwards;
}

.particle-3 {
  width: 24rpx;
  height: 24rpx;
  bottom: 90rpx;
  left: 50%;
  animation: floatAround 20s ease-in-out -12s infinite,
             particleFadeIn 1.5s ease-out 2.6s forwards;
}

@keyframes particleFadeIn {
  to {
    opacity: 0.5;
  }
}

@keyframes floatAround {
  0%, 100% {
    transform: translate(0, 0) scale(1);
    opacity: 0.25;
  }
  25% {
    transform: translate(15rpx, -20rpx) scale(1.1);
    opacity: 0.4;
  }
  50% {
    transform: translate(-10rpx, -35rpx) scale(0.95);
    opacity: 0.3;
  }
  75% {
    transform: translate(20rpx, -15rpx) scale(1.05);
    opacity: 0.45;
  }
}
