@import "../../styles/theme.wxss";

/**home.wxss**/

@keyframes page-appear {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 主容器 */
.page {
  height: 100vh;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  position: relative;
  box-sizing: border-box;
  background: linear-gradient(165deg, rgb(var(--background-rgb)) 0%, rgb(var(--background-end-rgb)) 100%);
}

/* 内容区域 */
.content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

@keyframes contentReveal {
  from {
    opacity: 0;
    transform: translateY(20rpx) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 日期显示 */
.date-display {
  font-family: 'Georgia', 'SourceHanSerifCN', 'Times New Roman', serif;
  font-size: 28rpx;
  color: var(--ink-muted);
  letter-spacing: 2rpx;
  margin-bottom: 100rpx;
}

@keyframes gentleReveal {
  from {
    opacity: 0;
    transform: translateY(-15rpx);
    filter: blur(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

/* 问候语容器 */
.greeting-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 180rpx;
  text-align: center;
}

@keyframes gentleFloat {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

/* 主问候语 */
.greeting {
  font-family: 'SourceHanSerifCN', 'Georgia', 'Palatino', 'Times New Roman', serif;
  font-size: 56rpx;
  font-weight: 400;
  color: var(--ink);
  line-height: 1.4;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

@keyframes poeticRise {
  from {
    opacity: 0;
    transform: translateY(35rpx) scale(0.96);
    filter: blur(10rpx);
  }
  60% {
    filter: blur(2rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
}

/* 副标题 */
.subtitle {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: 30rpx;
  font-weight: 300;
  color: var(--ink-soft);
  letter-spacing: 1rpx;
}

@keyframes subtleFade {
  from {
    opacity: 0;
    transform: translateY(20rpx);
    filter: blur(6rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

/* 按钮容器 */
.action-container {
  width: 100%;
  display: flex;
  justify-content: center;
}

@keyframes buttonEmerge {
  from {
    opacity: 0;
    transform: translateY(40rpx) scale(0.92);
    filter: blur(8rpx);
  }
  70% {
    filter: blur(1rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
}

/* 添加记录按钮 */
.add-button {
  background: rgba(var(--surface-rgb), 0.72);
  border: 1rpx solid rgba(var(--accent-rgb), 0.35);
  border-radius: 60rpx;
  padding: 0;
  width: 440rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 14rpx 36rpx rgba(var(--accent-deep-rgb), 0.16),
    0 6rpx 18rpx rgba(var(--secondary-rgb), 0.16),
    inset 0 1rpx 3rpx rgba(var(--surface-rgb), 0.75);
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  overflow: hidden;
  will-change: transform, box-shadow;
}

.add-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    135deg,
    rgba(var(--surface-rgb), 0.7) 0%,
    rgba(var(--surface-rgb), 0) 55%
  );
  opacity: 0;
  transition: opacity 0.3s ease;
}

.add-button::after {
  content: '';
}

.add-button-hover {
  transform: translateY(-6rpx) scale(1.02);
  background: rgba(var(--surface-rgb), 0.86);
  border-color: rgba(var(--accent-rgb), 0.5);
  box-shadow:
    0 18rpx 48rpx rgba(var(--accent-deep-rgb), 0.22),
    0 10rpx 24rpx rgba(var(--secondary-rgb), 0.22),
    inset 0 1rpx 3rpx rgba(var(--surface-rgb), 0.45);
}

.add-button-hover::before {
  opacity: 1;
}

/* 按钮内容 */
.button-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

/* 按钮图标 */
.button-icon {
  font-size: 36rpx;
  color: rgb(var(--muted-rgb));
  line-height: 1;
  animation: gentleSparkle 4.6s ease-in-out infinite;
  filter: drop-shadow(0 2rpx 6rpx rgba(var(--accent-deep-rgb), 0.25));
  will-change: transform, opacity;
}

@keyframes gentleSparkle {
  0%, 100% {
    opacity: 0.75;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.06);
  }
}

/* 按钮文字 */
.button-text {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: 32rpx;
  font-weight: 500;
  color: rgb(var(--ink-rgb));
  letter-spacing: 3rpx;
}

/* 装饰线 */
.decorative-line {
  position: absolute;
  bottom: 120rpx;
  width: 120rpx;
  height: 1rpx;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(var(--accent-rgb), 0.35) 50%,
    transparent 100%);
}

@keyframes lineExpand {
  from {
    opacity: 0;
    width: 0;
  }
  to {
    opacity: 1;
    width: 120rpx;
  }
}

/* 动画定义（保留用于兼容性） */

/* ========== 优雅极简 - 底部Tab栏 ========== */
.floating-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 0 48rpx calc(env(safe-area-inset-bottom) + 20rpx);
  z-index: 999;
  pointer-events: none;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: visible;
}

.floating-tab-bar::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(240rpx + env(safe-area-inset-bottom));
  background: linear-gradient(
    180deg,
    rgba(var(--background-rgb), 0) 0%,
    rgba(var(--background-rgb), 0.82) 35%,
    rgba(var(--background-rgb), 0.96) 100%
  );
  pointer-events: none;
  z-index: 0;
}

.floating-tab-bar::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: calc(env(safe-area-inset-bottom) + 16rpx);
  width: 360rpx;
  height: 110rpx;
  transform: translateX(-50%);
  background: radial-gradient(
    ellipse at center,
    rgba(var(--accent-rgb), 0.18) 0%,
    transparent 70%
  );
  filter: blur(30rpx);
  pointer-events: none;
  z-index: 0;
}

@keyframes tabBarRise {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.tab-capsule {
  position: relative;
  pointer-events: auto;
  display: flex;
  padding: 8rpx;
  gap: 0;
  border-radius: 56rpx;
  overflow: visible;
  width: 590rpx;
  box-sizing: border-box;
  z-index: 1;

  /* 毛玻璃效果 - 温暖米色调 */
  background: var(--glass);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);

  /* 精致边框 - 薰衣草 */
  border: 1rpx solid rgba(var(--accent-rgb), 0.2);

  /* 多层阴影 - 柔和紫调 */
  box-shadow:
    0 0 0 1rpx rgba(var(--accent-rgb), 0.08) inset,
    0 18rpx 52rpx rgba(var(--accent-deep-rgb), 0.12),
    0 8rpx 24rpx rgba(var(--accent-rgb), 0.12),
    0 2rpx 8rpx rgba(var(--secondary-rgb), 0.08);

  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.tab-capsule::before {
  content: '';
  position: absolute;
  top: -1rpx;
  left: -1rpx;
  right: -1rpx;
  bottom: -1rpx;
  border-radius: 56rpx;
  background: linear-gradient(135deg,
    rgba(var(--accent-rgb), 0.18) 0%,
    rgba(var(--secondary-rgb), 0.12) 50%,
    rgba(var(--accent-rgb), 0.18) 100%);
  z-index: -1;
  opacity: 0.5;
  filter: blur(6rpx);
}

.tab-capsule::after {
  content: '';
  position: absolute;
  top: 0;
  left: 25%;
  right: 25%;
  height: 1.5rpx;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(var(--surface-rgb), 0.7) 50%,
    transparent 100%);
  border-radius: 56rpx 56rpx 0 0;
  opacity: 0.5;
}

/* 活动指示器 - 柔和薰衣草 */
.ink-flow-indicator {
  position: absolute;
  top: 6rpx;
  left: 8rpx;
  width: calc((100% - 16rpx) / 3);
  height: calc(100% - 12rpx);
  border-radius: 50rpx;
  background: linear-gradient(135deg,
    rgba(var(--accent-rgb), 0.3) 0%,
    rgba(var(--secondary-rgb), 0.2) 100%);
  box-shadow:
    0 0 18rpx rgba(var(--accent-rgb), 0.2) inset,
    0 6rpx 18rpx rgba(var(--accent-deep-rgb), 0.18);
  transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 0;
}

.ink-flow-indicator::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50rpx;
  background: linear-gradient(45deg,
    rgba(var(--accent-rgb), 0.2) 0%,
    rgba(var(--secondary-rgb), 0.18) 25%,
    rgba(var(--accent-rgb), 0.12) 50%,
    rgba(var(--secondary-rgb), 0.16) 75%,
    rgba(var(--accent-rgb), 0.2) 100%);
  background-size: 300% 300%;
  animation: inkFlow 10s ease-in-out infinite;
  opacity: 0.5;
}

@keyframes inkFlow {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

/* Tab 项目 */
.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  min-width: 0;
  border-radius: 50rpx;
  z-index: 1;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.tab-item:active {
  transform: scale(0.94);
}

.icon-history {
  width: 32rpx;
  height: 36rpx;
  border: 2rpx solid var(--ink-muted);
  border-radius: 5rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 6rpx;
  gap: 5rpx;
  box-sizing: border-box;
}

.history-line {
  height: 2rpx;
  width: 100%;
  background: var(--ink-muted);
}

.history-line.short { width: 60%; }
.tab-item.active .icon-history { border-color: var(--ink); }
.tab-item.active .history-line { background: var(--ink); }

/* 墨滴涟漪图标 */
.tab-icon-wrapper {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-today {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 中心圆点 - 薰衣草 */
.ink-drop {
  width: 8rpx;
  height: 8rpx;
  background: radial-gradient(circle, rgb(var(--accent-rgb)) 0%, rgb(var(--accent-deep-rgb)) 100%);
  border-radius: 50%;
  position: absolute;
  z-index: 3;
  box-shadow: 0 0 8rpx rgba(var(--accent-rgb), 0.35);
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

/* 涟漪圆环 - 柔紫 */
.ripple {
  position: absolute;
  border-radius: 50%;
  border: 1rpx solid rgba(var(--accent-rgb), 0.8);
  opacity: 0.25;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.ripple-1 {
  width: 18rpx;
  height: 18rpx;
  z-index: 2;
}

.ripple-2 {
  width: 28rpx;
  height: 28rpx;
  z-index: 1;
}

.ripple-3 {
  width: 40rpx;
  height: 40rpx;
  z-index: 0;
}

/* 激活态 - 圆点强调 */
.tab-item.active .ink-drop {
  background: radial-gradient(circle, rgb(var(--accent-deep-rgb)) 0%, rgb(var(--muted-rgb)) 100%);
  box-shadow: 0 0 12rpx rgba(var(--accent-deep-rgb), 0.45);
  animation: inkDropPulse 2.5s ease-in-out infinite;
}

@keyframes inkDropPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.3);
    opacity: 0.85;
  }
}

/* 激活态 - 涟漪扩散 */
.tab-item.active .ripple {
  border-color: rgba(var(--accent-deep-rgb), 0.9);
  border-width: 1.5rpx;
}

.tab-item.active .ripple-1 {
  animation: rippleExpand 6s ease-out infinite;
  animation-delay: 0s;
}

.tab-item.active .ripple-2 {
  animation: rippleExpand 6s ease-out infinite;
  animation-delay: 1s;
}

.tab-item.active .ripple-3 {
  animation: rippleExpand 6s ease-out infinite;
  animation-delay: 2s;
}

@keyframes rippleExpand {
  0% {
    transform: scale(0.7);
    opacity: 0;
  }
  35% {
    opacity: 0.5;
  }
  100% {
    transform: scale(1.3);
    opacity: 0;
  }
}

/* 非激活态效果 */
.tab-item:not(.active) .ink-drop {
  opacity: 0.7;
}

.tab-item:not(.active) .ripple {
  opacity: 0.2;
}

/* 柱状图图标 - 柔紫调 */
.icon-chart {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 3rpx;
  height: 38rpx;
  padding: 4rpx 0;
}

.chart-bar {
  width: 6rpx;
  border-radius: 5rpx 5rpx 2rpx 2rpx;
  background: linear-gradient(180deg,
    rgba(var(--accent-rgb), 0.6) 0%,
    rgba(var(--accent-rgb), 0.25) 100%);
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.bar-1 { height: 14rpx; animation-delay: 0s; }
.bar-2 { height: 24rpx; animation-delay: 0.1s; }
.bar-3 { height: 32rpx; animation-delay: 0.2s; }
.bar-4 { height: 20rpx; animation-delay: 0.3s; }

.tab-item.active .chart-bar {
  background: linear-gradient(180deg,
    rgba(var(--accent-deep-rgb), 0.8) 0%,
    rgba(var(--accent-rgb), 0.5) 100%);
  box-shadow: 0 0 6rpx rgba(var(--accent-deep-rgb), 0.35);
  animation: barBounce 1.8s ease-in-out infinite;
}

@keyframes barBounce {
  0%, 100% { transform: scaleY(1); }
  50% { transform: scaleY(1.15); }
}

/* Tab 文字 - 衬线字体 */
.tab-label {
  font-family: 'SourceHanSerifCN', 'Georgia', 'Palatino', 'Times New Roman', serif;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-muted);
  letter-spacing: 0.5rpx;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  opacity: 0.65;
}

.tab-item.active .tab-label {
  color: var(--ink);
  font-weight: 500;
  opacity: 1;
  transform: scale(1.03);
  text-shadow: 0 1rpx 4rpx rgba(var(--accent-deep-rgb), 0.2);
}

/* 脉冲光晕 - 薰衣草 */
.pulse-halo {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 130%;
  height: 130%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle,
    rgba(var(--accent-rgb), 0.16) 0%,
    rgba(var(--secondary-rgb), 0.08) 50%,
    transparent 100%);
  z-index: -1;
  animation: pulsate 3s ease-in-out infinite;
  pointer-events: none;
}

@keyframes pulsate {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.6;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.1);
    opacity: 0.35;
  }
}

/* 装饰性漂浮粒子 - 柔紫 */
.float-particle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle,
    rgba(var(--accent-rgb), 0.18) 0%,
    rgba(var(--secondary-rgb), 0.1) 100%);
  pointer-events: none;
  z-index: -1;
  filter: blur(20rpx);
  animation: floatAround 20s ease-in-out infinite;
  opacity: 0;
  will-change: transform, opacity;
}

/* 粒子尺寸和位置 */
.particle-1 {
  width: 32rpx;
  height: 32rpx;
  bottom: 55rpx;
  left: 12%;
  animation: floatAround 20s ease-in-out 0s infinite,
             particleFadeIn 1.5s ease-out 2s forwards;
}

.particle-2 {
  width: 48rpx;
  height: 48rpx;
  bottom: 70rpx;
  right: 18%;
  animation: floatAround 20s ease-in-out -6s infinite,
             particleFadeIn 1.5s ease-out 2.3s forwards;
}

.particle-3 {
  width: 24rpx;
  height: 24rpx;
  bottom: 90rpx;
  left: 50%;
  animation: floatAround 20s ease-in-out -12s infinite,
             particleFadeIn 1.5s ease-out 2.6s forwards;
}

@keyframes particleFadeIn {
  to {
    opacity: 0.5;
  }
}

@keyframes floatAround {
  0%, 100% {
    transform: translate(0, 0) scale(1);
    opacity: 0.25;
  }
  25% {
    transform: translate(15rpx, -20rpx) scale(1.1);
    opacity: 0.4;
  }
  50% {
    transform: translate(-10rpx, -35rpx) scale(0.95);
    opacity: 0.3;
  }
  75% {
    transform: translate(20rpx, -15rpx) scale(1.05);
    opacity: 0.45;
  }
}

/* ========== 历史记录 ========== */
.stats-panel {
  position: absolute;
  inset: 0;
  --stats-side-padding: 60rpx;
  padding: var(--content-top, 160rpx) var(--stats-side-padding) calc(env(safe-area-inset-bottom) + 170rpx);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  animation: statsRise 0.9s cubic-bezier(0.23, 1, 0.32, 1) backwards;
}

@keyframes statsRise {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.stats-header {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 32rpx;
}

.stats-title {
  font-family: 'SourceHanSerifCN', 'Georgia', 'Palatino', 'Times New Roman', serif;
  font-size: 48rpx;
  font-weight: 400;
  color: var(--ink);
  letter-spacing: 3rpx;
}

.stats-subtitle {
  font-family: 'SourceHanSerifCN', 'Georgia', 'Times New Roman', serif;
  font-size: 24rpx;
  color: var(--ink-soft);
  letter-spacing: 1.5rpx;
}

.stats-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 26rpx;
}

.stats-list-wrapper {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: visible;
}

.filter-picker {
  flex: 1;
  min-width: 160rpx;
}

.filter-pill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(var(--surface-rgb), 0.88);
  border: 1rpx solid rgba(var(--accent-rgb), 0.25);
  box-shadow:
    0 10rpx 26rpx rgba(var(--accent-deep-rgb), 0.12),
    inset 0 1rpx 0 rgba(var(--surface-rgb), 0.85);
  transition: transform 0.35s ease, box-shadow 0.35s ease;
}

.filter-label {
  font-size: 20rpx;
  color: var(--ink-muted);
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.filter-value {
  font-family: 'Georgia', 'SourceHanSerifCN', 'Times New Roman', serif;
  font-size: 24rpx;
  color: var(--ink);
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.records-scroll {
  height: 100%;
  min-height: 0;
  position: relative;
  z-index: 1;
}

.records-inner {
  padding-bottom: 40rpx;
  min-height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  position: relative;
}

.scroll-indicator {
  position: absolute;
  top: 50%;
  right: 16rpx;
  width: 40rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  opacity: 0;
  transform: translateY(-50%) scale(0.98);
  transition: opacity 0.35s ease, transform 0.45s ease;
  z-index: 2;
}

.scroll-indicator.is-visible {
  opacity: 1;
  transform: translateY(-50%) scale(1);
}

.scroll-ticks {
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  padding: 6rpx 0;
}

.scroll-tick {
  height: 6rpx;
  width: 10rpx;
  border-radius: 999rpx;
  background: rgba(var(--muted-rgb), 0.22);
  transition: width 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
}

.scroll-tick.is-near {
  width: 18rpx;
  background: rgba(var(--muted-rgb), 0.45);
}

.scroll-tick.is-active {
  width: 30rpx;
  background: rgba(var(--ink-rgb), 0.78);
  box-shadow: 0 4rpx 12rpx rgba(var(--ink-rgb), 0.18);
}

.state-layer {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translateY(20rpx);
  transition: opacity 0.45s ease, transform 0.45s ease;
  pointer-events: none;
  z-index: 2;
}

.state-layer.is-visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.records-state {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.records-loading {
  padding: 20rpx 0;
}

.records-state-title {
  display: block;
  font-family: 'SourceHanSerifCN', 'Georgia', 'Times New Roman', serif;
  font-size: 30rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.records-state-subtitle {
  display: block;
  margin-top: 10rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: 24rpx;
  color: var(--ink-muted);
  letter-spacing: 1rpx;
}

.records-empty {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  justify-content: center;
  padding: 20rpx 0;
}

.records-list {
  position: relative;
  z-index: 1;
  opacity: 0;
  transform: translateY(20rpx);
  transition: opacity 0.45s ease, transform 0.45s ease, max-height 0.45s ease;
  max-height: 0;
  overflow: hidden;
  pointer-events: none;
}

.records-list.is-visible {
  opacity: 1;
  transform: translateY(0);
  max-height: 9999rpx;
  pointer-events: auto;
  padding-bottom: calc(env(safe-area-inset-bottom));
}

.records-pagination {
  position: relative;
  z-index: 1;
  min-height: 92rpx;
  padding: 8rpx 24rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  box-sizing: border-box;
}

.pagination-pulse {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(var(--muted-rgb), 0.34);
}

.pagination-pulse.is-loading {
  background: var(--lavender-deep);
  animation: paginationPulse 1.1s ease-in-out infinite;
}

.pagination-text {
  font-family: 'SourceHanSerifCN', 'Georgia', 'Times New Roman', serif;
  font-size: 21rpx;
  color: var(--ink-muted);
  letter-spacing: 1.2rpx;
}

@keyframes paginationPulse {
  0%, 100% {
    opacity: 0.35;
    transform: scale(0.8);
  }
  50% {
    opacity: 1;
    transform: scale(1.35);
  }
}

.empty-illustration {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-orb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: radial-gradient(circle,
    rgba(var(--accent-rgb), 0.45) 0%,
    rgba(var(--secondary-rgb), 0.18) 55%,
    transparent 75%);
  filter: blur(4rpx);
  opacity: 0.8;
}

.empty-ring {
  position: absolute;
  border-radius: 50%;
  border: 1rpx solid rgba(var(--accent-rgb), 0.35);
  animation: emptyPulse 4.2s ease-in-out infinite;
  opacity: 0.6;
}

.empty-ring.ring-1 {
  width: 120rpx;
  height: 120rpx;
}

.empty-ring.ring-2 {
  width: 168rpx;
  height: 168rpx;
  animation-delay: 0.9s;
}

@keyframes emptyPulse {
  0%, 100% {
    transform: scale(0.98);
    opacity: 0.45;
  }
  50% {
    transform: scale(1.04);
    opacity: 0.8;
  }
}

.empty-title {
  display: block;
  font-family: 'SourceHanSerifCN', 'Georgia', 'Times New Roman', serif;
  font-size: 30rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.empty-subtitle {
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: 24rpx;
  color: var(--ink-muted);
  letter-spacing: 1rpx;
}

.record-card {
  position: relative;
  overflow: hidden;
  border-radius: 30rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
  background: rgba(var(--surface-rgb), 0.94);
  border: 1rpx solid rgba(var(--accent-rgb), 0.14);
  box-shadow: none;
}

.record-card::before {
  content: none;
}

.top-record-card {
  flex: 0 0 auto;
  padding: 0;
  min-height: 224rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: stretch;
  overflow: hidden;
  background: rgb(var(--card-rgb));
  border: 1rpx solid rgba(var(--accent-deep-rgb), 0.24);
  box-shadow:
    0 14rpx 34rpx rgba(var(--shadow-rgb), 0.1),
    inset 0 1rpx 0 rgba(var(--surface-rgb), 0.9);
  transition: transform 0.28s ease, box-shadow 0.28s ease;
}

.top-record-card-hover {
  transform: scale(0.99);
  box-shadow: 0 8rpx 22rpx rgba(var(--shadow-rgb), 0.09);
}

.top-score-panel {
  width: 210rpx;
  flex: 0 0 210rpx;
  padding: 26rpx 18rpx 24rpx 26rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  color: rgb(var(--on-featured-rgb));
  background: rgb(var(--featured-rgb));
}

.top-score-kicker {
  font-family: 'SourceHanSerifCN', 'Georgia', 'Times New Roman', serif;
  font-size: 21rpx;
  color: rgba(var(--on-featured-rgb), 0.76);
  letter-spacing: 3rpx;
}

.top-score-display {
  display: flex;
  align-items: baseline;
  gap: 7rpx;
  margin: 8rpx 0;
}

.top-score-number {
  font-family: 'Georgia', 'Times New Roman', serif;
  font-size: 50rpx;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  color: rgb(var(--on-featured-rgb));
  letter-spacing: -1rpx;
}

.top-score-unit {
  font-size: 19rpx;
  color: rgba(var(--on-featured-rgb), 0.7);
}

.top-score-note {
  font-size: 18rpx;
  color: rgba(var(--on-featured-rgb), 0.52);
  letter-spacing: 2rpx;
}

.top-record-seam {
  position: relative;
  width: 1rpx;
  flex: 0 0 1rpx;
  margin: 20rpx 0;
  border-left: 1rpx dashed rgba(var(--accent-deep-rgb), 0.36);
}

.top-record-notch {
  position: absolute;
  left: -14rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: rgb(var(--notch-rgb));
  border: 1rpx solid rgba(var(--accent-deep-rgb), 0.12);
}

.top-record-notch.notch-top {
  top: -34rpx;
}

.top-record-notch.notch-bottom {
  bottom: -34rpx;
}

.top-record-details {
  min-width: 0;
  flex: 1;
  padding: 26rpx 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.top-record-date-row {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  margin-bottom: 20rpx;
}

.top-record-date-label {
  font-size: 18rpx;
  color: var(--ink-muted);
  letter-spacing: 2rpx;
}

.top-record-date {
  font-size: 28rpx;
  white-space: nowrap;
}

.top-record-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.top-record-tag {
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(var(--accent-rgb), 0.12);
}

.top-record-tag .tag-name {
  font-size: 20rpx;
  color: var(--ink-soft);
}

.top-record-tag .tag-count {
  font-size: 18rpx;
}

.top-record-meta {
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(var(--accent-rgb), 0.18);
}

.top-record-meta .meta-label {
  font-size: 19rpx;
}

.top-record-meta .meta-value {
  font-size: 22rpx;
}

.record-card-content {
  position: relative;
  z-index: 1;
}

.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.record-date {
  font-family: 'Georgia', 'SourceHanSerifCN', 'Times New Roman', serif;
  font-size: 30rpx;
  color: var(--ink);
  letter-spacing: 1.5rpx;
}

.record-score {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(var(--accent-rgb), 0.18);
  border: 1rpx solid rgba(var(--accent-rgb), 0.28);
}

.score-label {
  font-size: 20rpx;
  color: var(--ink-muted);
  letter-spacing: 1rpx;
}

.score-value {
  font-family: 'Georgia', 'SourceHanSerifCN', 'Times New Roman', serif;
  font-size: 30rpx;
  color: var(--lavender-deep);
}

.record-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.record-tag {
  display: flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(var(--secondary-rgb), 0.14);
  border: 1rpx solid rgba(var(--accent-rgb), 0.22);
  box-shadow: inset 0 1rpx 0 rgba(var(--surface-rgb), 0.6);
}

.tag-name {
  font-size: 22rpx;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.tag-count {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: var(--ink-soft);
}

.record-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(var(--accent-rgb), 0.2);
}

.meta-label {
  font-size: 22rpx;
  color: var(--ink-muted);
  letter-spacing: 1rpx;
}

.meta-value {
  font-family: 'SourceHanSerifCN', 'Georgia', 'Times New Roman', serif;
  font-size: 24rpx;
  color: var(--ink);
}

.page.theme-dark { background: #000; }
.theme-dark .float-particle,
.theme-dark .pulse-halo,
.theme-dark .decorative-line,
.theme-dark .empty-illustration,
.theme-dark .floating-tab-bar::after,
.theme-dark .tab-capsule::before,
.theme-dark .tab-capsule::after,
.theme-dark .ink-flow-indicator::before { display: none; }
.theme-dark .button-icon,
.theme-dark .ink-drop,
.theme-dark .ripple,
.theme-dark .chart-bar { animation: none; filter: none; box-shadow: none; }
.theme-dark .add-button,
.theme-dark .filter-pill,
.theme-dark .record-score,
.theme-dark .record-tag { background: #1c1c1c; border-color: #333; box-shadow: none; }
.theme-dark .add-button::before { display: none; }
.theme-dark .record-card { background: #111; border-color: #303030; box-shadow: none; }
.theme-dark .tab-capsule { background: #111; border-color: #333; border-radius: 32rpx; box-shadow: none; }
.theme-dark .tab-item { border-radius: 24rpx; }
.theme-dark .ink-flow-indicator { background: #2a2a2a; border-radius: 24rpx; box-shadow: none; }
.theme-dark .top-score-panel { background: #202020; }
.theme-dark .pagination-pulse { box-shadow: none; }
