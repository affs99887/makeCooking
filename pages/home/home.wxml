<!--home.wxml-->

<!-- Splash 启动画面组件 -->
<splash-screen
  wx:if="{{showSplash}}"
  bind:complete="onSplashComplete"
/>

<!-- 主内容（等待 splash 完成后显示） -->
<view class="page" wx:if="{{!showSplash}}">
  <view class="content" wx:if="{{activeTab === 'today'}}">
    <!-- 日期显示 -->
    <view class="date-display">{{currentDate}}</view>

    <!-- 问候语 -->
    <view class="greeting-container">
      <text class="greeting">{{greeting}}</text>
      <text class="subtitle">{{subtitle}}</text>
    </view>

    <!-- 添加记录按钮 -->
    <view class="action-container">
      <button class="add-button" bindtap="onAddRecord" hover-class="add-button-hover">
        <view class="button-content">
          <text class="button-icon">✦</text>
          <text class="button-text">记录今日</text>
        </view>
      </button>
    </view>

    <!-- 底部装饰线 -->
    <view class="decorative-line"></view>
  </view>

  <view class="stats-panel" wx:if="{{activeTab === 'stats'}}">
    <view class="stats-header">
      <text class="stats-title">历史记录</text>
      <text class="stats-subtitle">把每一次味道收进记忆</text>
    </view>

    <view class="stats-filters">
      <picker class="filter-picker"
              range="{{filterYearOptions}}"
              range-key="label"
              value="{{filterYearIndex}}"
              bindchange="onFilterYearChange">
        <view class="filter-pill">
          <text class="filter-label">年</text>
          <text class="filter-value">{{filterYearOptions[filterYearIndex].label}}</text>
        </view>
      </picker>
      <picker class="filter-picker"
              range="{{filterMonthOptions}}"
              range-key="label"
              value="{{filterMonthIndex}}"
              bindchange="onFilterMonthChange">
        <view class="filter-pill">
          <text class="filter-label">月</text>
          <text class="filter-value">{{filterMonthOptions[filterMonthIndex].label}}</text>
        </view>
      </picker>
      <picker class="filter-picker"
              range="{{filterDayOptions}}"
              range-key="label"
              value="{{filterDayIndex}}"
              bindchange="onFilterDayChange">
        <view class="filter-pill">
          <text class="filter-label">日</text>
          <text class="filter-value">{{filterDayOptions[filterDayIndex].label}}</text>
        </view>
      </picker>
    </view>

    <view class="stats-list-wrapper">
      <scroll-view class="records-scroll"
                   scroll-y
                   enhanced="true"
                   show-scrollbar="{{false}}"
                   scrollbar="none"
                   refresher-enabled
                   refresher-triggered="{{recordsRefreshing}}"
                   bindrefresherrefresh="onRecordsRefresh"
                   bindscroll="onRecordsScroll"
                   refresher-default-style="white">
        <view class="records-inner">
          <view class="state-layer records-loading-layer {{recordsStatus === 'loading' ? 'is-visible' : ''}}">
            <view class="records-state records-loading">
              <text class="records-state-title">正在整理你的记录</text>
              <text class="records-state-subtitle">请稍候片刻</text>
            </view>
          </view>

          <view class="state-layer records-empty-layer {{recordsStatus === 'loaded' && filteredRecords.length === 0 ? 'is-visible' : ''}}">
            <view class="records-empty">
              <view class="empty-illustration">
                <view class="empty-orb"></view>
                <view class="empty-ring ring-1"></view>
                <view class="empty-ring ring-2"></view>
              </view>
              <text class="empty-title">{{filtersActive ? '没有符合筛选的记录' : '还没有记录'}}</text>
              <text class="empty-subtitle">{{filtersActive ? '试试调整筛选条件' : '从今天开始写下味道'}}</text>
            </view>
          </view>

          <view class="records-list {{recordsStatus === 'loaded' && filteredRecords.length > 0 ? 'is-visible' : ''}}">
            <block wx:for="{{filteredRecords}}" wx:key="recordId" wx:for-item="record" wx:for-index="idx">
              <view class="record-card"
                    bindtap="onRecordCardTap"
                    data-index="{{idx}}">
                <view class="record-card-content">
                  <view class="record-header">
                    <text class="record-date">{{record.displayDateTime}}</text>
                    <view class="record-score">
                      <text class="score-label">评分</text>
                      <text class="score-value">{{record.score}}</text>
                    </view>
                  </view>

                  <view class="record-tags" wx:if="{{record.tags.length}}">
                    <view class="record-tag" wx:for="{{record.tags}}" wx:key="key" wx:for-item="tag">
                      <text class="tag-name">{{tag.label}}</text>
                      <text class="tag-count" wx:if="{{tag.count > 1}}">x{{tag.count}}</text>
                    </view>
                  </view>

                  <view class="record-meta" wx:if="{{record.methodLabel}}">
                    <text class="meta-label">手法</text>
                    <text class="meta-value">{{record.methodLabel}}</text>
                  </view>
                </view>
              </view>
            </block>
          </view>
        </view>
      </scroll-view>

      <view class="scroll-indicator is-visible">
        <view class="scroll-indicator-rail">
          <view class="scroll-indicator-thumb"
                style="height: {{scrollIndicatorThumbHeight}}px; --thumb-offset: {{scrollIndicatorOffset}}px;"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 流动墨水概念 - 底部Tab栏 -->
  <view class="floating-tab-bar">
    <!-- 毛玻璃胶囊容器 -->
    <view class="tab-capsule">
      <!-- 流动墨水背景指示器 -->
      <view class="ink-flow-indicator" style="transform: translateX({{activeTab === 'today' ? '0' : '100%'}})"></view>

      <!-- Today Tab -->
      <view class="tab-item {{activeTab === 'today' ? 'active' : ''}}"
            bindtap="onTabChange"
            data-tab="today">
        <view class="tab-icon-wrapper">
          <!-- 墨滴涟漪图标 -->
          <view class="icon-today">
            <view class="ink-drop"></view>
            <view class="ripple ripple-1"></view>
            <view class="ripple ripple-2"></view>
            <view class="ripple ripple-3"></view>
          </view>
        </view>
        <text class="tab-label">Today</text>
        <!-- 激活态脉冲光晕 -->
        <view class="pulse-halo" wx:if="{{activeTab === 'today'}}"></view>
      </view>

      <!-- 统计 Tab -->
      <view class="tab-item {{activeTab === 'stats' ? 'active' : ''}}"
            bindtap="onTabChange"
            data-tab="stats">
        <view class="tab-icon-wrapper">
          <!-- 柱状图图标 -->
          <view class="icon-chart">
            <view class="chart-bar bar-1"></view>
            <view class="chart-bar bar-2"></view>
            <view class="chart-bar bar-3"></view>
            <view class="chart-bar bar-4"></view>
          </view>
        </view>
        <text class="tab-label">统计</text>
        <!-- 激活态脉冲光晕 -->
        <view class="pulse-halo" wx:if="{{activeTab === 'stats'}}"></view>
      </view>
    </view>

    <!-- 装饰性漂浮粒子 -->
    <view class="float-particle particle-1"></view>
    <view class="float-particle particle-2"></view>
    <view class="float-particle particle-3"></view>
  </view>

  <!-- 记录抽屉组件 -->
  <record-drawer
    visible="{{showDrawer}}"
    mode="{{drawerMode}}"
    record="{{selectedRecord}}"
    bind:close="onDrawerClose"
    bind:save="onRecordSave"
    bind:update="onRecordUpdate"
    bind:delete="onRecordDelete"
  />
</view>
